    DocumentApp.HorizontalAlignment.RIGHT
  );


  body.appendParagraph('');


  /*****************************************************
   * REPORT INFORMATION
   *****************************************************/

  appendCorporateSectionHeading_(
    body,
    'REPORT INFORMATION'
  );


  const infoRows = [

    [
      'Unique Report ID',
      data.reportId
    ],

    [
      'Timestamp',
      formatDateTime_(
        data.timestamp
      )
    ],

    [
      'Originating Store Code',
      data.storeCode
    ],

    [
      'Originating Store / Hub',
      data.storeName
    ],

    [
      'Area',
      data.area
    ],

    [
      'Processor / Submitted By',
      data.submittedBy
    ],

    [
      'Turn-over To',
      data.turnoverType
    ],

    [
      'Destination Code',
      data.turnoverCode
    ],

    [
      'Destination Name',
      data.turnoverName
    ],

    [
      'Destination Type',
      data.turnoverType === 'BSC'
        ? 'BUSINESS CENTER (BSC)'
        : 'STORE'
    ],

    [
      'Cards Submitted',
      String(
        data.cards.length
      )
    ]

  ];


  const infoTable =
    body.appendTable(
      infoRows
    );

  infoTable.setBorderColor(
    '#D9E2F3'
  );

  infoTable.setBorderWidth(1);


  for (
    let r = 0;
    r < infoRows.length;
    r++
  ) {

    const labelCell =
      infoTable.getCell(r, 0);

    const valueCell =
      infoTable.getCell(r, 1);


    labelCell.setBackgroundColor(
      '#F2F6FA'
    );


    const label =
      labelCell
        .getChild(0)
        .asParagraph();

    label.setBold(true);
    label.setFontSize(9);
    label.setForegroundColor(
      '#24445C'
    );


    const value =
      valueCell
        .getChild(0)
        .asParagraph();

    value.setFontSize(9);
    value.setForegroundColor(
      '#222222'
    );

  }


  body.appendParagraph('');


  /*****************************************************
   * CARD SUMMARY
   *****************************************************/

  appendCorporateSectionHeading_(
    body,
    'CARD SUMMARY'
  );


  const summaryHeader = [

    'Sequence',
    '16-Digit Card Number',
    'Validation',
    'Status'

  ];


  const summaryRows =
    [summaryHeader];


  data.cards.forEach(function(card) {

    summaryRows.push([

      'CARD ' +
        card.sequence,

      /*
       * DISPLAY WITH SPACES
       */
      formatCardNumber_(
        card.cardNumber
      ),

      /^\d{16}$/.test(
        String(
          card.cardNumber || ''
        )
      )
        ? 'VALIDATED'
        : 'REVIEW',

      'REPORTED'

    ]);

  });


  const summaryTable =
    body.appendTable(
      summaryRows
    );

  summaryTable.setBorderColor(
    '#C9D5E2'
  );

  summaryTable.setBorderWidth(1);


  for (
    let c = 0;
    c < summaryHeader.length;
    c++
  ) {

    const cell =
      summaryTable.getCell(0, c);

    cell.setBackgroundColor(
      '#006FBA'
    );

    const p =
      cell
        .getChild(0)
        .asParagraph();

    p.setBold(true);
    p.setFontSize(8);
    p.setForegroundColor(
      '#FFFFFF'
    );

  }


  for (
    let r = 1;
    r < summaryRows.length;
    r++
  ) {

    for (
      let c = 0;
      c < summaryHeader.length;
      c++
    ) {

      const p =
        summaryTable
          .getCell(r, c)
          .getChild(0)
          .asParagraph();

      p.setFontSize(8);

      if (c === 2) {

        p.setBold(true);

        p.setForegroundColor(
          '#006FBA'
        );

      }

    }

  }


  body.appendParagraph('');


  /*****************************************************
   * CARD DETAILS
   *****************************************************/

  appendCorporateSectionHeading_(
    body,
    'CARD DETAILS'
  );


  data.cards.forEach(
    function(card, index) {

      if (index > 0) {

        body.appendPageBreak();

        appendCorporateSectionHeading_(
          body,
          'CARD ' +
          card.sequence +
          ' OF ' +
          data.cards.length
        );

      } else {

        const cardHeading =
          body.appendParagraph(
            'CARD 1 OF ' +
            data.cards.length
          );

        cardHeading.setBold(true);
        cardHeading.setFontSize(12);
        cardHeading.setForegroundColor(
          '#006FBA'
        );

      }


      const cardInfo =
        body.appendTable([

          [
            'Card Sequence',
            'CARD ' +
              card.sequence
          ],

          [
            'Card Number',
            /*
             * DISPLAY WITH SPACES
             */
            formatCardNumber_(
              card.cardNumber
            )
          ],

          [
            'OCR Engine',
            'Tesseract.js — Browser OCR'
          ],

          [
            'Validation',
            /^\d{16}$/.test(
              String(
                card.cardNumber || ''
              )
            )
              ? '16-DIGIT NUMBER VALIDATED'
              : 'REVIEW REQUIRED'
          ],

          [
            'Workflow Status',
            'REPORTED'
          ]

        ]);


      cardInfo.setBorderColor(
        '#D9E2F3'
      );

      cardInfo.setBorderWidth(1);


      for (
        let r = 0;
        r < 5;
        r++
      ) {

        cardInfo
          .getCell(r, 0)
          .setBackgroundColor(
            '#F2F6FA'
          );


        const lp =
          cardInfo
            .getCell(r, 0)
            .getChild(0)
            .asParagraph();

        lp.setBold(true);
        lp.setFontSize(9);
        lp.setForegroundColor(
          '#24445C'
        );


        const vp =
          cardInfo
            .getCell(r, 1)
            .getChild(0)
            .asParagraph();

        vp.setFontSize(9);


        if (r === 1) {

          vp.setBold(true);
          vp.setFontSize(12);

        }


        if (r === 3) {

          vp.setBold(true);
          vp.setForegroundColor(
            '#006FBA'
          );

        }

      }


      body.appendParagraph('');


      const imageHeading =
        body.appendParagraph(
          'CAPTURED CARD IMAGE'
        );

      imageHeading.setBold(true);
      imageHeading.setFontSize(9);
      imageHeading.setForegroundColor(
        '#555555'
      );


      try {

        const image =
          body.appendImage(
            card.imageBlob
          );

        const maxWidth = 430;
        const maxHeight = 300;

        let width =
          image.getWidth();

        let height =
          image.getHeight();


        if (width > maxWidth) {

          const ratio =
            maxWidth / width;

          width = maxWidth;

          height =
            Math.round(
              height * ratio
            );

        }


        if (height > maxHeight) {

          const ratio =
            maxHeight / height;

          height = maxHeight;

          width =
            Math.round(
              width * ratio
            );

        }


        image.setWidth(width);
        image.setHeight(height);


      } catch (imageError) {

        const p =
          body.appendParagraph(
            'Card image could not be embedded.'
          );

        p.setItalic(true);

        p.setForegroundColor(
          '#A00000'
        );

      }


      body.appendParagraph('');


      const review =
        body.appendTable([

          [
            'REVIEW CHECK',
            'RESULT'
          ],

          [
            '16-digit card number',
            /^\d{16}$/.test(
              String(
                card.cardNumber || ''
              )
            )
              ? 'PASS'
              : 'REVIEW'
          ],

          [
            'Card image captured / uploaded',
            'PASS'
          ],

          [
            'OCR source',
            'Tesseract.js Browser OCR'
          ]

        ]);


      review.setBorderColor(
        '#D9E2F3'
      );

      review.setBorderWidth(1);


      for (
        let c = 0;
        c < 2;
        c++
      ) {

        const p =
          review
            .getCell(0, c)
            .getChild(0)
            .asParagraph();

        p.setBold(true);
        p.setFontSize(8);
        p.setForegroundColor(
          '#FFFFFF'
        );

        review
          .getCell(0, c)
          .setBackgroundColor(
            '#006FBA'
          );

      }


      for (
        let r = 1;
        r < 4;
        r++
      ) {

        for (
          let c = 0;
          c < 2;
          c++
        ) {

          const p =
            review
              .getCell(r, c)
              .getChild(0)
              .asParagraph();

          p.setFontSize(8);

        }

      }

    }
  );


  /*****************************************************
   * TRANSACTION CONTROL
   *****************************************************/

  body.appendPageBreak();


  appendCorporateSectionHeading_(
    body,
    'TRANSACTION CONTROL'
  );


  const controlTable =
    body.appendTable([

      [
        'Report ID',
        data.reportId
      ],

      [
        'Total Cards',
        String(
          data.cards.length
        )
      ],

      [
        'Originating Location',
        data.storeCode +
        ' - ' +
        data.storeName
      ],

      [
        'Turn-over Destination',
        data.turnoverCode +
        ' - ' +
        data.turnoverName
      ],

      [
        'Destination Type',
        data.turnoverType === 'BSC'
          ? 'BUSINESS CENTER'
          : 'SAME STORE'
      ],

      [
        'Submission Status',
        'SUBMITTED / REPORTED'
      ],

      [
        'PDF Generated',
        'YES'
      ]

    ]);


  controlTable.setBorderColor(
    '#D9E2F3'
  );

  controlTable.setBorderWidth(1);


  for (
    let r = 0;
    r < 7;
    r++
  ) {

    controlTable
      .getCell(r, 0)
      .setBackgroundColor(
        '#F2F6FA'
      );


    const lp =
      controlTable
        .getCell(r, 0)
        .getChild(0)
        .asParagraph();

    lp.setBold(true);
    lp.setFontSize(9);
    lp.setForegroundColor(
      '#24445C'
    );


    const vp =
      controlTable
        .getCell(r, 1)
        .getChild(0)
        .asParagraph();

    vp.setFontSize(9);

  }


  body.appendParagraph('');


  const note =
    body.appendParagraph(
      'This document is system-generated from the LBC-RPC Portal. ' +
      'The card number was captured and validated through the portal workflow. ' +
      'Retain this report as part of the card custody and movement record.'
    );


  note.setFontSize(8);

  note.setForegroundColor(
    '#666666'
  );


  body.appendParagraph('');


  const footerLine =
    body.appendParagraph(
      CONFIG.FOOTER
    );

  footerLine.setAlignment(
    DocumentApp.HorizontalAlignment.CENTER
  );

  footerLine.setFontSize(8);

  footerLine.setForegroundColor(
    '#777777'
  );


  /*****************************************************
   * CONVERT TO PDF
   *****************************************************/

  doc.saveAndClose();


  const docFile =
    DriveApp.getFileById(
      doc.getId()
    );


  const pdfBlob =
    docFile
      .getAs(MimeType.PDF)
      .setName(
        data.reportId +
        '_LBC-RPC_REPORT.pdf'
      );


  const pdfFile =
    folder.createFile(
      pdfBlob
    );


  /*
   * Remove temporary Google Doc.
   */
  docFile.setTrashed(true);


  return {

    fileId:
      pdfFile.getId(),

    url:
      pdfFile.getUrl(),

    blob:
      pdfBlob

  };

}


/*******************************************************
 * PDF SECTION HEADING
 *******************************************************/

function appendCorporateSectionHeading_(
  body,
  text
) {

  const table =
    body.appendTable([
      [text]
    ]);


  table.setBorderWidth(0);


  table
    .getCell(0, 0)
    .setBackgroundColor(
      '#006FBA'
    );


  const p =
    table
      .getCell(0, 0)
      .getChild(0)
      .asParagraph();


  p.setBold(true);
  p.setFontSize(10);
  p.setForegroundColor(
    '#FFFFFF'
  );


  body.appendParagraph('');

}


/*******************************************************
 * GET COMPANY LOGO BLOB
 *******************************************************/

function getCompanyLogoBlob_() {

  try {

    const folder =
      DriveApp.getFolderById(
        CONFIG.COMPANY_LOGO_FOLDER_ID
      );


    const names = [
      'company-logo.jpeg',
      'company-logo.jpg',
      'company-logo.png'
    ];


    for (
      let i = 0;
      i < names.length;
      i++
    ) {

      const files =
        folder.getFilesByName(
          names[i]
        );


      if (files.hasNext()) {

        return files.next().getBlob();

      }

    }

  } catch (e) {

    console.log(
      'PDF logo error: ' +
      e.message
    );

  }


  return null;

}


