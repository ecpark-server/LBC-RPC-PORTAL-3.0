/*******************************************************
 * GET MAIN OFFICE EMAIL RECIPIENTS
 *******************************************************/

function getMainOfficeEmailRecipients_() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      CONFIG.EMAIL_SHEET
    );


  if (!sheet) {

    throw new Error(
      'Sheet "' +
      CONFIG.EMAIL_SHEET +
      '" was not found.'
    );

  }


  const lastRow =
    sheet.getLastRow();

  const lastCol =
    sheet.getLastColumn();


  if (
    lastRow < 2 ||
    lastCol < 1
  ) {

    throw new Error(
      'Sheet "' +
      CONFIG.EMAIL_SHEET +
      '" has no recipient records.'
    );

  }


  const values =
    sheet
      .getRange(
        1,
        1,
        lastRow,
        lastCol
      )
      .getDisplayValues();


  const headers =
    values[0].map(function(h) {

      return String(
        h || ''
      )
        .trim()
        .toLowerCase();

    });


  const emailCol =
    headers.indexOf('email');


  if (emailCol === -1) {

    throw new Error(
      'The "Email" column was not found in sheet "' +
      CONFIG.EMAIL_SHEET +
      '".'
    );

  }


  const emails = [];


  for (
    let r = 1;
    r < values.length;
    r++
  ) {

    const email =
      String(
        values[r][emailCol] || ''
      ).trim();


    if (
      email &&
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
        email
      )
    ) {

      emails.push(email);

    }

  }


  return Array.from(
    new Set(emails)
  );

}


/*******************************************************
 * SEND MAIN OFFICE EMAIL
 *******************************************************/

function sendMainOfficeBatchEmail_(data) {

  try {

    const recipients =
      getMainOfficeEmailRecipients_();


    if (!recipients.length) {

      return (
        'EMAIL ERROR: ' +
        'No valid email addresses found in the Email sheet.'
      );

    }


    const cards =
      data.cards
        .map(function(c) {

          return (
            'Card #' +
            c.sequence +
            ': ' +
            /*
             * DISPLAY WITH SPACES
             */
            formatCardNumber_(
              c.cardNumber
            )
          );

        })
        .join('\n');


    const body = [

      CONFIG.SYSTEM_TITLE,

      '',

      'LBC-RPC REPORT',

      '',

      'Unique Report ID: ' +
        data.reportId,

      'Store Code: ' +
        data.storeCode,

      'Store / Hub Name: ' +
        data.storeName,

      'Area: ' +
        data.area,

      'Processor / Submitted By: ' +
        data.submittedBy,

      'Turn-over To: ' +
        data.turnoverType,

      'Turn-over Code: ' +
        data.turnoverCode,

      'Turn-over Location: ' +
        data.turnoverName,

      '',

      'CARD NUMBERS:',

      cards,

      '',

      'Please see the attached PDF report.',

      '',

      CONFIG.FOOTER

    ].join('\n');


    MailApp.sendEmail({

      to:
        recipients.join(','),

      subject:
        'LBC-RPC Report - ' +
        data.reportId +
        ' - ' +
        data.cards.length +
        ' Card(s)',

      body:
        body,

      attachments:
        [data.pdfBlob],

      name:
        CONFIG.SYSTEM_TITLE

    });


    return (
      'EMAIL SENT TO: ' +
      recipients.join(', ')
    );


  } catch (e) {

    return (
      'EMAIL ERROR: ' +
      e.message
    );

  }

}


