  );

}


/*******************************************************
 * PARSE DATA URL
 *******************************************************/

function parseDataUrl_(dataUrl) {

  const m =
    String(dataUrl || '')
      .match(
        /^data:([^;]+);base64,(.+)$/
      );


  if (!m) {

    throw new Error(
      'Invalid card image data.'
    );

  }


  return {

    mimeType:
      m[1],

    bytes:
      Utilities.base64Decode(
        m[2]
      )

  };

}


/*******************************************************
 * FILE EXTENSION
 *******************************************************/

function getExtensionFromMime_(mime) {

  return {

    'image/jpeg':
      'jpg',

    'image/jpg':
      'jpg',

    'image/png':
      'png',

    'image/webp':
      'webp',

    'image/heic':
      'heic'

  }[mime] || 'jpg';

}


/*******************************************************
 * DATE / TIME
 *******************************************************/

function formatDateTime_(date) {

  return Utilities.formatDate(

    date,

    Session.getScriptTimeZone() ||
      'Asia/Manila',

    'MM/dd/yyyy hh:mm:ss a'

  );

}
