function getCompanyLogo_() {

  try {

    const folder =
      DriveApp.getFolderById(
        CONFIG.COMPANY_LOGO_FOLDER_ID
      );

    const names = [
      'company-logo.jpeg',
      'company-logo.jpg',
      'company-logo.png'
    ];

    for (let i = 0; i < names.length; i++) {

      const files =
        folder.getFilesByName(names[i]);

      if (files.hasNext()) {

        const blob = files.next().getBlob();

        return (
          'data:' +
          blob.getContentType() +
          ';base64,' +
          Utilities.base64Encode(
            blob.getBytes()
          )
        );

      }

    }

  } catch (e) {

    console.log(
      'Logo error: ' + e.message
    );

  }

  return '';

}


