/*******************************************************
 * CARD NUMBER NORMALIZATION
 *******************************************************/

/*
 * Converts:
 *
 * 5000 0000 0898 7462
 *
 * to:
 *
 * 5000000008987462
 */
function normalizeCardNumber_(cardNumber) {

  return String(cardNumber || '')
    .replace(/\D/g, '')
    .substring(0, 16);

}


/*
 * Display-only formatting:
 *
 * 5000000008987462
 *
 * becomes:
 *
 * 5000 0000 0898 7462
 *
 * IMPORTANT:
 * This does NOT change the backend value.
 */
function formatCardNumber_(cardNumber) {

  const digits =
    normalizeCardNumber_(cardNumber);

  return digits.replace(
    /(\d{4})(?=\d)/g,
    '$1 '
  );

}


/*******************************************************
 * CHECK EXISTING CARD NUMBERS
 *
 * CARD DATABASE
 * Column G = Card Number
 *******************************************************/

function checkExistingCardNumbers(cardNumbers) {

  const wanted = Array.from(
    new Set(
      (cardNumbers || [])
        .map(normalizeCardNumber_)
        .filter(function(n) {
          return /^\d{16}$/.test(n);
        })
    )
  );

  if (!wanted.length) {
    return [];
  }

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      CONFIG.CARD_DATABASE_SHEET
    );

  if (!sheet) {
    throw new Error(
      'Sheet "' +
      CONFIG.CARD_DATABASE_SHEET +
      '" was not found.'
    );
  }

  if (sheet.getLastRow() < 2) {
    return [];
  }

  /*
   * Column G = Card Number
   */
  const values =
    sheet
      .getRange(
        2,
        7,
        sheet.getLastRow() - 1,
        1
      )
      .getDisplayValues();

  const existing = {};

  values.forEach(function(row) {

    const number =
      normalizeCardNumber_(row[0]);

    if (/^\d{16}$/.test(number)) {
      existing[number] = true;
    }

  });

  return wanted.filter(function(number) {
    return existing[number] === true;
  });

}


/*******************************************************
 * CHECK DUPLICATES INSIDE CURRENT BATCH
 *******************************************************/

function findBatchDuplicateCards_(cards) {

  const seen = {};
  const duplicates = {};

  cards.forEach(function(card) {

    const number =
      normalizeCardNumber_(
        card.cardNumber
      );

    if (!number) {
      return;
    }

    if (seen[number]) {
      duplicates[number] = true;
    }

    seen[number] = true;

  });

  return Object.keys(duplicates);

}


/*******************************************************
 * SAVE CARD BATCH
 *
 * DUPLICATE CHECK HAPPENS BEFORE:
 *
 * - Image upload
 * - OCR file
 * - PDF
 * - Email
 * - Database save
 *******************************************************/

function saveCardBatch(batch) {

  if (!batch) {
    throw new Error(
      'No report data received.'
    );
  }

  const reportId =
    String(batch.uniqueId || '').trim();

  const storeCode =
    String(batch.storeCode || '').trim();

  const storeName =
    String(batch.storeName || '').trim();

  const area =
    String(batch.area || '').trim();

  const submittedBy =
    String(batch.processor || '').trim();

  const turnoverType =
    String(batch.turnoverType || '')
      .trim()
      .toUpperCase();

  const turnoverCode =
    String(batch.turnoverCode || '').trim();

  const turnoverName =
    String(batch.turnoverName || '').trim();

  const cards =
    Array.isArray(batch.cards)
      ? batch.cards
      : [];


  /*****************************************************
   * BASIC VALIDATION
   *****************************************************/

  if (!reportId) {
    throw new Error(
      'Unique Report ID is required.'
    );
  }

  if (!storeCode || !storeName) {
    throw new Error(
      'Store Code and Store / Hub Name are required.'
    );
  }

  if (!submittedBy) {
    throw new Error(
      'Processor / Submitted By is required.'
    );
  }

  if (!cards.length) {
    throw new Error(
      'At least one card is required.'
    );
  }

  if (
    turnoverType !== 'SAME STORE' &&
    turnoverType !== 'BSC'
  ) {
    throw new Error(
      'Please select the turn-over destination.'
    );
  }

  if (!turnoverCode || !turnoverName) {
    throw new Error(
      'Please select the turn-over location.'
    );
  }


  /*****************************************************
   * NORMALIZE CARD NUMBERS
   *****************************************************/

  cards.forEach(function(card) {

    card.cardNumber =
      normalizeCardNumber_(
        card.cardNumber
      );

  });


  /*****************************************************
   * VALIDATE ALL CARD NUMBERS
   *****************************************************/

  cards.forEach(function(card, index) {

    if (
      !/^\d{16}$/.test(
        String(card.cardNumber || '')
      )
    ) {

      throw new Error(
        'Card #' +
        (index + 1) +
        ' must contain exactly 16 digits.'
      );

    }

    if (!card.imageData) {

      throw new Error(
        'Card #' +
        (index + 1) +
        ' image is required.'
      );

    }

  });


  /*****************************************************
   * CHECK DUPLICATES WITHIN CURRENT BATCH
   *****************************************************/

  const batchDuplicates =
    findBatchDuplicateCards_(cards);

  if (batchDuplicates.length) {

    const formatted =
      batchDuplicates.map(
        formatCardNumber_
      );

    throw new Error(
      'DUPLICATE CARD NUMBER IN THIS SUBMISSION:\n\n' +
      formatted.join('\n') +
      '\n\nThe same card cannot be submitted twice.'
    );

  }


  /*****************************************************
   * CHECK EXISTING DATABASE RECORDS
   *
   * IMPORTANT:
   * THIS HAPPENS BEFORE ANY DRIVE FILE IS CREATED.
   *****************************************************/

  const cardNumbers =
    cards.map(function(card) {
      return card.cardNumber;
    });


  const existingCards =
    checkExistingCardNumbers(
      cardNumbers
    );


  if (existingCards.length) {

    const formatted =
      existingCards.map(
        formatCardNumber_
      );

    throw new Error(
      'CARD ALREADY REPORTED:\n\n' +
      formatted.join('\n') +
      '\n\nThe submission was not saved.'
    );

  }


  /*****************************************************
   * LOCK
   *
   * Prevents two users from submitting the same card
   * simultaneously.
   *****************************************************/

  const lock =
    LockService.getScriptLock();

  lock.waitLock(30000);

  try {

    /*
     * CHECK AGAIN AFTER LOCK.
     *
     * This is important because another user could have
     * submitted the same card between the first check
     * and acquiring the lock.
     */

    const existingAfterLock =
      checkExistingCardNumbers(
        cardNumbers
      );

    if (existingAfterLock.length) {

      const formatted =
        existingAfterLock.map(
          formatCardNumber_
        );

      throw new Error(
        'CARD ALREADY REPORTED:\n\n' +
        formatted.join('\n') +
        '\n\nThe submission was not saved.'
      );

    }


    /***************************************************
     * CREATE FILES
     ***************************************************/

    const imageFolder =
      DriveApp.getFolderById(
        CONFIG.CARD_IMAGES_FOLDER_ID
      );

    const ocrFolder =
      DriveApp.getFolderById(
        CONFIG.OCR_FOLDER_ID
      );

    const timestamp =
      new Date();

    const saved = [];


    /***************************************************
     * SAVE CARD IMAGES + OCR
     ***************************************************/

    cards.forEach(function(card, index) {

      const parsed =
        parseDataUrl_(
          card.imageData
        );


      const filename =
        reportId +
        '_CARD' +
        String(index + 1).padStart(2, '0') +
        '_' +
        card.cardNumber +
        '.' +
        getExtensionFromMime_(
          parsed.mimeType
        );


      const imageBlob =
        Utilities.newBlob(
          parsed.bytes,
          parsed.mimeType,
          filename
        );


      const imageFile =
        imageFolder.createFile(
          imageBlob
        );


      /*
       * OCR TXT
       */

      const ocrContent = [

        CONFIG.SYSTEM_TITLE,
        '',

        'Unique Report ID: ' +
          reportId,

        'Card Sequence: ' +
          (index + 1),

        /*
         * Backend value remains unformatted.
         */
        'Card Number: ' +
          card.cardNumber,

        /*
         * Human-readable version.
         */
        'Card Number Display: ' +
          formatCardNumber_(
            card.cardNumber
          ),

        'Store Code: ' +
          storeCode,

        'Store / Hub Name: ' +
          storeName,

        'Area: ' +
          area,

        'Processor / Submitted By: ' +
          submittedBy,

        'Turn-over To: ' +
          turnoverType,

        'Turn-over Code: ' +
          turnoverCode,

        'Turn-over Location: ' +
          turnoverName,

        '',

        'OCR Source: Tesseract.js Browser OCR',

        '',

        'OCR RAW RESULT:',

        String(
          card.ocrRawText || ''
        )

      ].join('\n');


      const ocrFile =
        ocrFolder.createFile(
          reportId +
          '_CARD' +
          String(index + 1).padStart(2, '0') +
          '_OCR.txt',

          ocrContent,

          MimeType.PLAIN_TEXT
        );


      saved.push({

        sequence: index + 1,

        /*
         * BACKEND VALUE
         */
        cardNumber:
          card.cardNumber,

        /*
         * DISPLAY VALUE
         */
        cardNumberDisplay:
          formatCardNumber_(
            card.cardNumber
          ),

        imageBlob:
          imageBlob,

        imageFile:
          imageFile,

        ocrFile:
          ocrFile

      });

    });


    /***************************************************
     * CREATE PDF
     ***************************************************/

    const pdf =
      createLbcRpcBatchPdf_({

        reportId:
          reportId,

        timestamp:
          timestamp,

        storeCode:
          storeCode,

        storeName:
          storeName,

        area:
          area,

        submittedBy:
          submittedBy,

        turnoverType:
          turnoverType,

        turnoverCode:
          turnoverCode,

        turnoverName:
          turnoverName,

        cards:
          saved

      });


    /***************************************************
     * SEND EMAIL
     ***************************************************/

    const emailStatus =
      sendMainOfficeBatchEmail_({

        reportId:
          reportId,

        storeCode:
          storeCode,

        storeName:
          storeName,

        area:
          area,

        submittedBy:
          submittedBy,

        turnoverType:
          turnoverType,

        turnoverCode:
          turnoverCode,

        turnoverName:
          turnoverName,

        cards:
          saved,

        pdfBlob:
          pdf.blob

      });


    /***************************************************
     * SAVE TO CARD DATABASE
     ***************************************************/

    saveBatchToCardDatabase_({

      reportId:
        reportId,

      timestamp:
        timestamp,

      storeCode:
        storeCode,

      storeName:
        storeName,

      area:
        area,

      submittedBy:
        submittedBy,

      turnoverType:
        turnoverType,

      turnoverCode:
        turnoverCode,

      turnoverName:
        turnoverName,

      cards:
        saved,

      pdfFileId:
        pdf.fileId,

      pdfUrl:
        pdf.url,

      emailStatus:
        emailStatus

    });


    /***************************************************
     * SUCCESS RESPONSE
     ***************************************************/

    return {

      success:
        true,

      count:
        saved.length,

      reportId:
        reportId,

      pdfFileId:
        pdf.fileId,

      pdfUrl:
        pdf.url,

      emailStatus:
        emailStatus,

      cards:
        saved.map(function(card) {

          return {

            sequence:
              card.sequence,

            /*
             * BACKEND
             */
            cardNumber:
              card.cardNumber,

            /*
             * DISPLAY
             */
            cardNumberDisplay:
              card.cardNumberDisplay

          };

        })

    };

  } finally {

    lock.releaseLock();

  }

}


/*******************************************************
 * SAVE TO CARD DATABASE
 *******************************************************/

function saveBatchToCardDatabase_(data) {

  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        CONFIG.CARD_DATABASE_SHEET
      );


  if (!sheet) {

    throw new Error(
      'Sheet "' +
      CONFIG.CARD_DATABASE_SHEET +
      '" was not found.'
    );

  }


  const headers = [

    'Unique ID',
    'Timestamp',
    'Store Code',
    'Store / Hub Name',
    'Area',
    'Processor / Submitted By',
    'Card Number',
    'Image File ID',
    'Image URL',
    'Status',
    'Email Address',
    'PDF File ID',
    'PDF URL',
    'PDF Status',
    'Turn-over To',
    'Turn-over Code',
    'Turn-over Location',
    'Card Sequence'

  ];


  if (sheet.getLastRow() === 0) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([headers]);

  } else {

    const current =
      sheet
        .getRange(
          1,
          1,
          1,
          Math.max(
            sheet.getLastColumn(),
            headers.length
          )
        )
        .getDisplayValues()[0];


    headers.forEach(function(h, i) {

      if (!current[i]) {

        sheet
          .getRange(
            1,
            i + 1
          )
          .setValue(h);

      }

    });

  }


  /*
   * IMPORTANT:
   * Card Number is stored WITHOUT SPACES.
   */

  const rows =
    data.cards.map(function(c) {

      return [

        data.reportId,

        data.timestamp,

        data.storeCode,

        data.storeName,

        data.area,

        data.submittedBy,

        /*
         * BACKEND:
         * 5000000008987462
         */
        c.cardNumber,

        c.imageFile.getId(),

        c.imageFile.getUrl(),

        'REPORTED',

        '',

        data.pdfFileId,

        data.pdfUrl,

        'GENERATED',

        data.turnoverType,

        data.turnoverCode,

        data.turnoverName,

        c.sequence

      ];

    });


  sheet
    .getRange(
      Math.max(
        sheet.getLastRow() + 1,
        2
      ),
      1,
      rows.length,
      headers.length
    )
    .setValues(rows);

}


/*******************************************************
 * CREATE PDF
 *******************************************************/

function createLbcRpcBatchPdf_(data) {

  const folder =
    DriveApp.getFolderById(
      CONFIG.PDF_REPORTS_FOLDER_ID
    );


  const doc =
    DocumentApp.create(
      'TEMP_' + data.reportId
    );


  const body =
    doc.getBody();


  /*****************************************************
   * PAGE SETUP
   *****************************************************/

  body.setMarginTop(36);
  body.setMarginBottom(36);
  body.setMarginLeft(42);
  body.setMarginRight(42);


  /*****************************************************
   * HEADER / BRANDING
   *****************************************************/

  const headerTable =
    body.appendTable([
      ['', '']
    ]);

  headerTable.setBorderWidth(0);


  const logoCell =
    headerTable.getCell(0, 0);

  const titleCell =
    headerTable.getCell(0, 1);


  try {

    const logoBlob =
      getCompanyLogoBlob_();

    if (logoBlob) {

      const logo =
        logoCell.appendImage(
          logoBlob
        );

      const maxLogoWidth = 85;

      if (
        logo.getWidth() >
        maxLogoWidth
      ) {

        const ratio =
          maxLogoWidth /
          logo.getWidth();

        logo.setWidth(
          maxLogoWidth
        );

        logo.setHeight(
          Math.round(
            logo.getHeight() *
            ratio
          )
        );

      }

    }

  } catch (logoError) {

    // Continue without logo.

  }


  const brand =
    titleCell.appendParagraph(
      CONFIG.SYSTEM_TITLE
    );

  brand.setBold(true);
  brand.setFontSize(18);
  brand.setForegroundColor(
    '#006FBA'
  );


  const subtitle =
    titleCell.appendParagraph(
      'LBC-RPC CARD REPORT'
    );

  subtitle.setBold(true);
  subtitle.setFontSize(10);
  subtitle.setForegroundColor(
    '#555555'
  );


  const confidentiality =
    titleCell.appendParagraph(
      'INTERNAL CONTROL DOCUMENT'
    );

  confidentiality.setFontSize(8);
  confidentiality.setForegroundColor(
    '#777777'
  );


  body.appendParagraph('');


  /*****************************************************
   * REPORT BANNER
   *****************************************************/

  const banner =
    body.appendTable([
      [
        'LBC-RPC REPORT',
        data.reportId
      ]
    ]);

  banner.setBorderWidth(0);


