/*******************************************************
 * UNIQUE REPORT ID
 *******************************************************/

function generateRPCUniqueId() {

  const lock = LockService.getScriptLock();

  lock.waitLock(30000);

  try {

    const tz =
      Session.getScriptTimeZone() ||
      'Asia/Manila';

    const now = new Date();

    return (
      'RPC-' +
      Utilities.formatDate(
        now,
        tz,
        'yyyyMMdd-HHmmss'
      ) +
      '-' +
      Math.floor(
        1000 + Math.random() * 9000
      )
    );

  } finally {

    lock.releaseLock();

  }
}


