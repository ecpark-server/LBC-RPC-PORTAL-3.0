    .setBackgroundColor(
      '#006FBA'
    );

  banner.getCell(0, 1)
    .setBackgroundColor(
      '#006FBA'
    );


  const bannerTitle =
    banner
      .getCell(0, 0)
      .getChild(0)
      .asParagraph();

  bannerTitle.setBold(true);
  bannerTitle.setFontSize(12);
  bannerTitle.setForegroundColor(
    '#FFFFFF'
  );


  const bannerId =
