function getCardHistorySheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(CONFIG.CARD_HISTORY_SHEET);

  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.CARD_HISTORY_SHEET);
  }

  ensureHeaders_(sheet, getCardHistoryHeaders_());
  return sheet;
}

function ensureHeaders_(sheet, headers) {
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    return;
  }

  const width = Math.max(sheet.getLastColumn(), headers.length);
  const current = sheet.getRange(1, 1, 1, width).getDisplayValues()[0];

  headers.forEach(function(h, i) {
    if (!current[i]) sheet.getRange(1, i + 1).setValue(h);
  });
}

/**
 * Creates the first history event when a card is reported.
 */
function appendInitialCardHistory_(data) {
  const sheet = getCardHistorySheet_();
  const rows = data.cards.map(function(card) {
    return [
      generateHistoryId_(),
      card.cardNumber,
      card.cardNumberDisplay,
      data.reportId,
      data.timestamp,
      'CARD REPORTED',
      'REPORTED',
      '',
      data.turnoverCode + ' - ' + data.turnoverName,
      data.storeCode,
      data.storeName,
      data.area,
      data.submittedBy,
      '',
      card.imageFile.getId(),
      card.imageFile.getUrl(),
      data.pdfFileId,
      data.pdfUrl,
      'Initial card report / capture.'
    ];
  });

  sheet.getRange(Math.max(sheet.getLastRow() + 1, 2), 1, rows.length, 19)
    .setValues(rows);
