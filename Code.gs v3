/**
 * Main Release Card transaction.
 *
 * Required:
 *   cardNumber
 *   processorUser
 *   releasedTo
 *
 * Optional:
 *   remarks
 *
 * Current allowed state:
 *   REPORTED
 *
 * Result:
 *   CARD DATABASE J is changed to RELEASED.
 *   A CARD HISTORY row is appended.
 */
function releaseCard(payload) {
  payload = payload || {};

  const cardNumber = normalizeCardNumber_(payload.cardNumber);
  const processorUser = String(payload.processorUser || '').trim();
  const releasedTo = String(payload.releasedTo || '').trim();
  const remarks = String(payload.remarks || '').trim();

  if (!/^\d{16}$/.test(cardNumber)) {
    throw new Error('Please enter exactly 16 digits for the card number.');
  }

  if (!processorUser) {
    throw new Error('Processor / User is required.');
  }

  if (!releasedTo) {
    throw new Error('Released To is required.');
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  let sheet = null;
  let rowNumber = 0;
  let oldStatus = '';
  let historyRow = 0;

  try {
    const found = locateCardRow_(cardNumber);

    if (!found) {
      throw new Error('CARD NOT FOUND:\n\n' + formatCardNumber_(cardNumber));
    }

    sheet = found.sheet;
    rowNumber = found.rowNumber;
    oldStatus = found.status;

    if (String(oldStatus).trim().toUpperCase() !== 'REPORTED') {
      throw new Error(
        'CARD CANNOT BE RELEASED.\n\n' +
        'Card: ' + formatCardNumber_(cardNumber) + '\n' +
        'Current Status: ' + (oldStatus || 'BLANK') + '\n\n' +
        'Only cards with status REPORTED can be released.'
      );
    }

    const timestamp = new Date();
    const releaseReportId = generateReleaseId_();
    const historyId = generateHistoryId_();

    const fromLocation = buildLocation_(found.storeCode, found.storeName);
    const toLocation = found.turnoverLocation
      ? found.turnoverLocation
      : fromLocation;

    /*
     * Update current-state database first.
     * If history creation fails, status is rolled back.
     */
    sheet.getRange(rowNumber, 10).setValue('RELEASED');

    try {
      const historySheet = getCardHistorySheet_();

      const historyRowValues = [[
        historyId,
        cardNumber,
        formatCardNumber_(cardNumber),
        releaseReportId,
        timestamp,
        'CARD RELEASED',
        'RELEASED',
        fromLocation,
        toLocation,
        found.storeCode,
        found.storeName,
        found.area,
        processorUser,
        releasedTo,
        found.imageFileId,
        found.imageUrl,
        found.pdfFileId,
        found.pdfUrl,
        remarks || 'Card released through LBC-RPC Portal.'
      ]];

      historyRow = Math.max(historySheet.getLastRow() + 1, 2);
      historySheet.getRange(historyRow, 1, 1, 19).setValues(historyRowValues);

    } catch (historyError) {
      sheet.getRange(rowNumber, 10).setValue(oldStatus);
      throw new Error(
        'Release was not completed because CARD HISTORY could not be saved: ' +
        historyError.message
      );
    }

    return {
      success: true,
      releaseReportId: releaseReportId,
      historyId: historyId,
      eventDateTime: formatDateTime_(timestamp),
      cardNumber: cardNumber,
      cardNumberDisplay: formatCardNumber_(cardNumber),
      status: 'RELEASED',
      releasedTo: releasedTo,
      fromLocation: fromLocation,
      toLocation: toLocation,
      storeCode: found.storeCode,
      storeName: found.storeName,
      area: found.area,
      imageFileId: found.imageFileId,
      imageUrl: found.imageUrl,
      pdfFileId: found.pdfFileId,
      pdfUrl: found.pdfUrl
    };

  } finally {
    lock.releaseLock();
  }
}

/**
 * Finds the exact CARD DATABASE row for a card.
 */
function locateCardRow_(cardNumber) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(CONFIG.CARD_DATABASE_SHEET);

  if (!sheet) {
    throw new Error('Sheet "' + CONFIG.CARD_DATABASE_SHEET + '" was not found.');
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;

  const values = sheet.getRange(2, 1, lastRow - 1, 18).getDisplayValues();

  for (let i = 0; i < values.length; i++) {
    const row = values[i];
    const databaseCard = normalizeCardNumber_(row[6]);

    if (databaseCard === cardNumber) {
      return {
        sheet: sheet,
        rowNumber: i + 2,
        uniqueId: row[0] || '',
        timestamp: row[1] || '',
        storeCode: row[2] || '',
        storeName: row[3] || '',
        area: row[4] || '',
        processor: row[5] || '',
        cardNumber: databaseCard,
        imageFileId: row[7] || '',
        imageUrl: row[8] || '',
        status: row[9] || '',
        emailAddress: row[10] || '',
        pdfFileId: row[11] || '',
        pdfUrl: row[12] || '',
        pdfStatus: row[13] || '',
        turnoverType: row[14] || '',
        turnoverCode: row[15] || '',
        turnoverLocation: row[16] || '',
        cardSequence: row[17] || ''
      };
    }
  }

  return null;
}

function buildLocation_(code, name) {
  const c = String(code || '').trim();
  const n = String(name || '').trim();
  if (c && n) return c + ' - ' + n;
  return c || n;
}

/**
 * Returns history records for one card.
 */
function getCardHistory(cardNumber) {
  const number = normalizeCardNumber_(cardNumber);

  if (!/^\d{16}$/.test(number)) {
    throw new Error('Please enter exactly 16 digits.');
  }

  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(CONFIG.CARD_HISTORY_SHEET);

  if (!sheet || sheet.getLastRow() < 2) return [];

  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 19).getDisplayValues();

  return values.filter(function(row) {
    return normalizeCardNumber_(row[1]) === number;
  }).map(function(row) {
    return {
      historyId: row[0],
      cardNumber: normalizeCardNumber_(row[1]),
      cardNumberDisplay: row[2],
      reportId: row[3],
      eventDateTime: row[4],
      eventType: row[5],
      status: row[6],
      fromLocation: row[7],
      toLocation: row[8],
      storeCode: row[9],
      storeName: row[10],
      area: row[11],
      processorUser: row[12],
      releasedTo: row[13],
      imageFileId: row[14],
      imageUrl: row[15],
      pdfFileId: row[16],
      pdfUrl: row[17],
      remarks: row[18]
    };
  });
}

/* ========================= LOCATE CARD ========================= */

function locateCard(cardNumber) {
  const wantedCard = normalizeCardNumber_(cardNumber);

  if (!/^\d{16}$/.test(wantedCard)) {
    throw new Error('Please enter exactly 16 digits.');
  }

  const found = locateCardRow_(wantedCard);

  if (!found) {
    return { found: false, cardNumber: wantedCard };
  }

  return {
    found: true,
    uniqueId: found.uniqueId,
    timestamp: found.timestamp,
    storeCode: found.storeCode,
    storeName: found.storeName,
    area: found.area,
    processor: found.processor,
    cardNumber: found.cardNumber,
    cardNumberDisplay: formatCardNumber_(found.cardNumber),
    imageFileId: found.imageFileId,
    imageUrl: found.imageUrl,
    status: found.status,
    emailAddress: found.emailAddress,
    pdfFileId: found.pdfFileId,
    pdfUrl: found.pdfUrl,
    pdfStatus: found.pdfStatus,
    turnoverType: found.turnoverType,
    turnoverCode: found.turnoverCode,
    turnoverLocation: found.turnoverLocation,
    cardSequence: found.cardSequence
  };
}

function searchCardLocation(cardNumber) {
  return locateCard(cardNumber);
}

function cardExists(cardNumber) {
  const number = normalizeCardNumber_(cardNumber);
  if (!/^\d{16}$/.test(number)) return false;
  return locateCard(number).found === true;
}

function getLocateCardDisplayNumber(cardNumber) {
  return formatCardNumber_(cardNumber);
}

function getDashboardUrl() {
  return ScriptApp.getService().getUrl();
}

/* ========================= PDF ========================= */

function createLbcRpcBatchPdf_(data) {
  const folder = DriveApp.getFolderById(CONFIG.PDF_REPORTS_FOLDER_ID);
  const doc = DocumentApp.create('TEMP_' + data.reportId);
  const body = doc.getBody();

  body.setMarginTop(36); body.setMarginBottom(36);
  body.setMarginLeft(42); body.setMarginRight(42);

  const headerTable = body.appendTable([['', '']]);
  headerTable.setBorderWidth(0);

  try {
    const logoBlob = getCompanyLogoBlob_();
    if (logoBlob) {
      const logo = headerTable.getCell(0, 0).appendImage(logoBlob);
      const maxLogoWidth = 85;
      if (logo.getWidth() > maxLogoWidth) {
        const ratio = maxLogoWidth / logo.getWidth();
        logo.setWidth(maxLogoWidth);
        logo.setHeight(Math.round(logo.getHeight() * ratio));
      }
    }
  } catch (e) {}

  const titleCell = headerTable.getCell(0, 1);
  const brand = titleCell.appendParagraph(CONFIG.SYSTEM_TITLE);
  brand.setBold(true).setFontSize(18).setForegroundColor('#006FBA');
  const subtitle = titleCell.appendParagraph('LBC-RPC CARD REPORT');
  subtitle.setBold(true).setFontSize(10).setForegroundColor('#555555');
  const confidentiality = titleCell.appendParagraph('INTERNAL CONTROL DOCUMENT');
  confidentiality.setFontSize(8).setForegroundColor('#777777');

  body.appendParagraph('');

  const banner = body.appendTable([['LBC-RPC REPORT', data.reportId]]);
  banner.setBorderWidth(0);
  banner.getCell(0, 0).setBackgroundColor('#006FBA');
  banner.getCell(0, 1).setBackgroundColor('#006FBA');

  const bannerTitle = banner.getCell(0, 0).getChild(0).asParagraph();
  bannerTitle.setBold(true).setFontSize(12).setForegroundColor('#FFFFFF');
  const bannerId = banner.getCell(0, 1).getChild(0).asParagraph();
  bannerId.setBold(true).setFontSize(11).setForegroundColor('#FFFFFF')
    .setAlignment(DocumentApp.HorizontalAlignment.RIGHT);

  body.appendParagraph('');
  appendCorporateSectionHeading_(body, 'REPORT INFORMATION');

  const infoRows = [
    ['Unique Report ID', data.reportId],
    ['Timestamp', formatDateTime_(data.timestamp)],
    ['Originating Store Code', data.storeCode],
    ['Originating Store / Hub', data.storeName],
    ['Area', data.area],
    ['Processor / Submitted By', data.submittedBy],
    ['Turn-over To', data.turnoverType],
    ['Destination Code', data.turnoverCode],
    ['Destination Name', data.turnoverName],
    ['Destination Type', data.turnoverType === 'BSC' ? 'BUSINESS CENTER (BSC)' : 'STORE'],
    ['Cards Submitted', String(data.cards.length)]
  ];

  const infoTable = body.appendTable(infoRows);
  infoTable.setBorderColor('#D9E2F3').setBorderWidth(1);

  for (let r = 0; r < infoRows.length; r++) {
    infoTable.getCell(r, 0).setBackgroundColor('#F2F6FA');
    const lp = infoTable.getCell(r, 0).getChild(0).asParagraph();
    lp.setBold(true).setFontSize(9).setForegroundColor('#24445C');
    infoTable.getCell(r, 1).getChild(0).asParagraph()
      .setFontSize(9).setForegroundColor('#222222');
  }

  body.appendParagraph('');
  appendCorporateSectionHeading_(body, 'CARD SUMMARY');

  const summaryRows = [['Sequence','16-Digit Card Number','Validation','Status']];
  data.cards.forEach(function(card) {
    summaryRows.push([
      'CARD ' + card.sequence,
      formatCardNumber_(card.cardNumber),
      /^\d{16}$/.test(String(card.cardNumber || '')) ? 'VALIDATED' : 'REVIEW',
      'REPORTED'
    ]);
  });

  const summaryTable = body.appendTable(summaryRows);
  summaryTable.setBorderColor('#C9D5E2').setBorderWidth(1);

  for (let c = 0; c < 4; c++) {
    const cell = summaryTable.getCell(0, c);
    cell.setBackgroundColor('#006FBA');
    cell.getChild(0).asParagraph().setBold(true).setFontSize(8).setForegroundColor('#FFFFFF');
  }

  for (let r = 1; r < summaryRows.length; r++) {
    for (let c = 0; c < 4; c++) {
      summaryTable.getCell(r, c).getChild(0).asParagraph().setFontSize(8);
    }
  }

  body.appendParagraph('');
  appendCorporateSectionHeading_(body, 'CARD DETAILS');

  data.cards.forEach(function(card, index) {
    if (index > 0) {
      body.appendPageBreak();
      appendCorporateSectionHeading_(body, 'CARD ' + card.sequence + ' OF ' + data.cards.length);
    } else {
      const heading = body.appendParagraph('CARD 1 OF ' + data.cards.length);
      heading.setBold(true).setFontSize(12).setForegroundColor('#006FBA');
    }

    const cardInfo = body.appendTable([
      ['Card Sequence','CARD ' + card.sequence],
      ['Card Number',formatCardNumber_(card.cardNumber)],
      ['OCR Engine','Tesseract.js — Browser OCR'],
      ['Validation',/^\d{16}$/.test(String(card.cardNumber || '')) ? '16-DIGIT NUMBER VALIDATED' : 'REVIEW REQUIRED'],
      ['Workflow Status','REPORTED']
    ]);

    cardInfo.setBorderColor('#D9E2F3').setBorderWidth(1);

    for (let r = 0; r < 5; r++) {
      cardInfo.getCell(r, 0).setBackgroundColor('#F2F6FA');
      cardInfo.getCell(r, 0).getChild(0).asParagraph().setBold(true).setFontSize(9).setForegroundColor('#24445C');
      const vp = cardInfo.getCell(r, 1).getChild(0).asParagraph().setFontSize(9);
      if (r === 1) vp.setBold(true).setFontSize(12);
      if (r === 3) vp.setBold(true).setForegroundColor('#006FBA');
    }

    body.appendParagraph('');
    const imageHeading = body.appendParagraph('CAPTURED CARD IMAGE');
    imageHeading.setBold(true).setFontSize(9).setForegroundColor('#555555');

    try {
      const image = body.appendImage(card.imageBlob);
      const maxWidth = 430, maxHeight = 300;
      let width = image.getWidth(), height = image.getHeight();

      if (width > maxWidth) {
        const ratio = maxWidth / width;
        width = maxWidth; height = Math.round(height * ratio);
      }
      if (height > maxHeight) {
        const ratio = maxHeight / height;
        height = maxHeight; width = Math.round(width * ratio);
      }
      image.setWidth(width); image.setHeight(height);
    } catch (e) {
      body.appendParagraph('Card image could not be embedded.').setItalic(true).setForegroundColor('#A00000');
    }

    body.appendParagraph('');

    const review = body.appendTable([
      ['REVIEW CHECK','RESULT'],
      ['16-digit card number',/^\d{16}$/.test(String(card.cardNumber || '')) ? 'PASS' : 'REVIEW'],
      ['Card image captured / uploaded','PASS'],
      ['OCR source','Tesseract.js Browser OCR']
    ]);

    review.setBorderColor('#D9E2F3').setBorderWidth(1);
    for (let c = 0; c < 2; c++) {
      review.getCell(0, c).setBackgroundColor('#006FBA');
      review.getCell(0, c).getChild(0).asParagraph().setBold(true).setFontSize(8).setForegroundColor('#FFFFFF');
    }
    for (let r = 1; r < 4; r++) {
      for (let c = 0; c < 2; c++) review.getCell(r, c).getChild(0).asParagraph().setFontSize(8);
    }
  });

  body.appendPageBreak();
  appendCorporateSectionHeading_(body, 'TRANSACTION CONTROL');

  const controlTable = body.appendTable([
    ['Report ID',data.reportId],
    ['Total Cards',String(data.cards.length)],
    ['Originating Location',data.storeCode + ' - ' + data.storeName],
    ['Turn-over Destination',data.turnoverCode + ' - ' + data.turnoverName],
    ['Destination Type',data.turnoverType === 'BSC' ? 'BUSINESS CENTER' : 'SAME STORE'],
    ['Submission Status','SUBMITTED / REPORTED'],
    ['PDF Generated','YES']
  ]);

  controlTable.setBorderColor('#D9E2F3').setBorderWidth(1);
  for (let r = 0; r < 7; r++) {
    controlTable.getCell(r, 0).setBackgroundColor('#F2F6FA');
    controlTable.getCell(r, 0).getChild(0).asParagraph().setBold(true).setFontSize(9).setForegroundColor('#24445C');
    controlTable.getCell(r, 1).getChild(0).asParagraph().setFontSize(9);
  }

  body.appendParagraph('');
  body.appendParagraph(
    'This document is system-generated from the LBC-RPC Portal. ' +
    'The card number was captured and validated through the portal workflow. ' +
    'Retain this report as part of the card custody and movement record.'
  ).setFontSize(8).setForegroundColor('#666666');

  body.appendParagraph('');
  body.appendParagraph(CONFIG.FOOTER)
    .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
    .setFontSize(8).setForegroundColor('#777777');

  doc.saveAndClose();

  const docFile = DriveApp.getFileById(doc.getId());
  const pdfBlob = docFile.getAs(MimeType.PDF)
    .setName(data.reportId + '_LBC-RPC_REPORT.pdf');
  const pdfFile = folder.createFile(pdfBlob);
  docFile.setTrashed(true);

  return { fileId: pdfFile.getId(), url: pdfFile.getUrl(), blob: pdfBlob };
}

function appendCorporateSectionHeading_(body, text) {
  const table = body.appendTable([[text]]);
  table.setBorderWidth(0);
  table.getCell(0, 0).setBackgroundColor('#006FBA');
  table.getCell(0, 0).getChild(0).asParagraph()
    .setBold(true).setFontSize(10).setForegroundColor('#FFFFFF');
  body.appendParagraph('');
}

function getCompanyLogoBlob_() {
  try {
    const folder = DriveApp.getFolderById(CONFIG.COMPANY_LOGO_FOLDER_ID);
    const names = ['company-logo.jpeg','company-logo.jpg','company-logo.png'];

    for (let i = 0; i < names.length; i++) {
      const files = folder.getFilesByName(names[i]);
      if (files.hasNext()) return files.next().getBlob();
    }
  } catch (e) {
    console.log('PDF logo error: ' + e.message);
  }
  return null;
}

