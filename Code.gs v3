/* ========================= CARD NUMBER ========================= */

function normalizeCardNumber_(cardNumber) {
  return String(cardNumber || '').replace(/\D/g, '').substring(0, 16);
}

function formatCardNumber_(cardNumber) {
  const digits = normalizeCardNumber_(cardNumber);
  return digits.replace(/(\d{4})(?=\d)/g, '$1 ');
}

/* ========================= CARD DATABASE LOOKUP ========================= */

function checkExistingCardNumbers(cardNumbers) {
  const wanted = Array.from(new Set((cardNumbers || [])
    .map(normalizeCardNumber_)
    .filter(function(n) { return /^\d{16}$/.test(n); })));

  if (!wanted.length) return [];

  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(CONFIG.CARD_DATABASE_SHEET);

  if (!sheet) throw new Error('Sheet "' + CONFIG.CARD_DATABASE_SHEET + '" was not found.');
  if (sheet.getLastRow() < 2) return [];

  const values = sheet.getRange(2, 7, sheet.getLastRow() - 1, 1).getDisplayValues();
  const existing = {};

  values.forEach(function(row) {
    const number = normalizeCardNumber_(row[0]);
    if (/^\d{16}$/.test(number)) existing[number] = true;
  });

  return wanted.filter(function(number) { return existing[number] === true; });
}

function findBatchDuplicateCards_(cards) {
  const seen = {};
  const duplicates = {};

  cards.forEach(function(card) {
    const number = normalizeCardNumber_(card.cardNumber);
    if (!number) return;
    if (seen[number]) duplicates[number] = true;
    seen[number] = true;
  });

  return Object.keys(duplicates);
}

/* ========================= SAVE CARD BATCH ========================= */
/* Existing submission logic retained. */

function saveCardBatch(batch) {
  if (!batch) throw new Error('No report data received.');

  const reportId = String(batch.uniqueId || '').trim();
  const storeCode = String(batch.storeCode || '').trim();
  const storeName = String(batch.storeName || '').trim();
  const area = String(batch.area || '').trim();
  const submittedBy = String(batch.processor || '').trim();
  const turnoverType = String(batch.turnoverType || '').trim().toUpperCase();
  const turnoverCode = String(batch.turnoverCode || '').trim();
  const turnoverName = String(batch.turnoverName || '').trim();
  const cards = Array.isArray(batch.cards) ? batch.cards : [];

  if (!reportId) throw new Error('Unique Report ID is required.');
  if (!storeCode || !storeName) throw new Error('Store Code and Store / Hub Name are required.');
  if (!submittedBy) throw new Error('Processor / Submitted By is required.');
  if (!cards.length) throw new Error('At least one card is required.');

  if (turnoverType !== 'SAME STORE' && turnoverType !== 'BSC') {
    throw new Error('Please select the turn-over destination.');
  }
  if (!turnoverCode || !turnoverName) throw new Error('Please select the turn-over location.');

  cards.forEach(function(card) {
    card.cardNumber = normalizeCardNumber_(card.cardNumber);
  });

  cards.forEach(function(card, index) {
    if (!/^\d{16}$/.test(String(card.cardNumber || ''))) {
      throw new Error('Card #' + (index + 1) + ' must contain exactly 16 digits.');
    }
    if (!card.imageData) throw new Error('Card #' + (index + 1) + ' image is required.');
  });

  const batchDuplicates = findBatchDuplicateCards_(cards);
  if (batchDuplicates.length) {
    throw new Error('DUPLICATE CARD NUMBER IN THIS SUBMISSION:\n\n' +
      batchDuplicates.map(formatCardNumber_).join('\n') +
      '\n\nThe same card cannot be submitted twice.');
  }

  const cardNumbers = cards.map(function(card) { return card.cardNumber; });
  const existingCards = checkExistingCardNumbers(cardNumbers);

  if (existingCards.length) {
    throw new Error('CARD ALREADY REPORTED:\n\n' +
      existingCards.map(formatCardNumber_).join('\n') +
      '\n\nThe submission was not saved.');
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    const existingAfterLock = checkExistingCardNumbers(cardNumbers);
    if (existingAfterLock.length) {
      throw new Error('CARD ALREADY REPORTED:\n\n' +
        existingAfterLock.map(formatCardNumber_).join('\n') +
        '\n\nThe submission was not saved.');
    }

    const imageFolder = DriveApp.getFolderById(CONFIG.CARD_IMAGES_FOLDER_ID);
    const ocrFolder = DriveApp.getFolderById(CONFIG.OCR_FOLDER_ID);
    const timestamp = new Date();
    const saved = [];

    cards.forEach(function(card, index) {
      const parsed = parseDataUrl_(card.imageData);
      const filename = reportId + '_CARD' +
        String(index + 1).padStart(2, '0') + '_' +
        card.cardNumber + '.' + getExtensionFromMime_(parsed.mimeType);

      const imageBlob = Utilities.newBlob(parsed.bytes, parsed.mimeType, filename);
      const imageFile = imageFolder.createFile(imageBlob);

      const ocrContent = [
        CONFIG.SYSTEM_TITLE, '',
        'Unique Report ID: ' + reportId,
        'Card Sequence: ' + (index + 1),
        'Card Number: ' + card.cardNumber,
        'Card Number Display: ' + formatCardNumber_(card.cardNumber),
        'Store Code: ' + storeCode,
        'Store / Hub Name: ' + storeName,
        'Area: ' + area,
        'Processor / Submitted By: ' + submittedBy,
        'Turn-over To: ' + turnoverType,
        'Turn-over Code: ' + turnoverCode,
        'Turn-over Location: ' + turnoverName, '',
        'OCR Source: Tesseract.js Browser OCR', '',
        'OCR RAW RESULT:',
        String(card.ocrRawText || '')
      ].join('\n');

      const ocrFile = ocrFolder.createFile(
        reportId + '_CARD' + String(index + 1).padStart(2, '0') + '_OCR.txt',
        ocrContent,
        MimeType.PLAIN_TEXT
      );

      saved.push({
        sequence: index + 1,
        cardNumber: card.cardNumber,
        cardNumberDisplay: formatCardNumber_(card.cardNumber),
        imageBlob: imageBlob,
        imageFile: imageFile,
        ocrFile: ocrFile
      });
    });

    const pdf = createLbcRpcBatchPdf_({
      reportId: reportId, timestamp: timestamp, storeCode: storeCode,
      storeName: storeName, area: area, submittedBy: submittedBy,
      turnoverType: turnoverType, turnoverCode: turnoverCode,
      turnoverName: turnoverName, cards: saved
    });

    const emailStatus = sendMainOfficeBatchEmail_({
      reportId: reportId, storeCode: storeCode, storeName: storeName,
      area: area, submittedBy: submittedBy, turnoverType: turnoverType,
      turnoverCode: turnoverCode, turnoverName: turnoverName,
      cards: saved, pdfBlob: pdf.blob
    });

    saveBatchToCardDatabase_({
      reportId: reportId, timestamp: timestamp, storeCode: storeCode,
      storeName: storeName, area: area, submittedBy: submittedBy,
      turnoverType: turnoverType, turnoverCode: turnoverCode,
      turnoverName: turnoverName, cards: saved,
      pdfFileId: pdf.fileId, pdfUrl: pdf.url, emailStatus: emailStatus
    });

    /* NEW: initial CARD HISTORY record for every newly reported card. */
    appendInitialCardHistory_( {
      reportId: reportId,
      timestamp: timestamp,
      storeCode: storeCode,
      storeName: storeName,
      area: area,
      submittedBy: submittedBy,
      turnoverType: turnoverType,
      turnoverCode: turnoverCode,
      turnoverName: turnoverName,
      cards: saved,
      pdfFileId: pdf.fileId,
      pdfUrl: pdf.url
    });

    return {
      success: true, count: saved.length, reportId: reportId,
      pdfFileId: pdf.fileId, pdfUrl: pdf.url, emailStatus: emailStatus,
      cards: saved.map(function(card) {
        return {
          sequence: card.sequence,
          cardNumber: card.cardNumber,
          cardNumberDisplay: card.cardNumberDisplay
        };
      })
    };
  } finally {
    lock.releaseLock();
  }
}

/* ========================= CARD DATABASE WRITE ========================= */

function saveBatchToCardDatabase_(data) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(CONFIG.CARD_DATABASE_SHEET);

  if (!sheet) throw new Error('Sheet "' + CONFIG.CARD_DATABASE_SHEET + '" was not found.');

  const headers = [
    'Unique ID','Timestamp','Store Code','Store / Hub Name','Area',
    'Processor / Submitted By','Card Number','Image File ID','Image URL',
    'Status','Email Address','PDF File ID','PDF URL','PDF Status',
    'Turn-over To','Turn-over Code','Turn-over Location','Card Sequence'
  ];

  ensureHeaders_(sheet, headers);

  const rows = data.cards.map(function(c) {
    return [
      data.reportId, data.timestamp, data.storeCode, data.storeName,
      data.area, data.submittedBy, c.cardNumber,
      c.imageFile.getId(), c.imageFile.getUrl(), 'REPORTED', '',
      data.pdfFileId, data.pdfUrl, 'GENERATED',
      data.turnoverType, data.turnoverCode, data.turnoverName, c.sequence
    ];
  });

  sheet.getRange(Math.max(sheet.getLastRow() + 1, 2), 1, rows.length, headers.length)
    .setValues(rows);
}

