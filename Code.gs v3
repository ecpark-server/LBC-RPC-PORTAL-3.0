function generateUniqueId_(prefix) {
  const tz = Session.getScriptTimeZone() || 'Asia/Manila';
  const now = new Date();
  return prefix + '-' +
    Utilities.formatDate(now, tz, 'yyyyMMdd-HHmmss') +
    '-' + Math.floor(1000 + Math.random() * 9000);
}

