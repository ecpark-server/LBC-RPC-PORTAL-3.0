<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  >

  <title>LBC-RPC PORTAL - Locate Card</title>

  <style>

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f7fa;
      color: #222;
    }

    body {
      min-height: 100vh;
    }

    .page {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* =====================================================
       HEADER
       ===================================================== */

    .header {
      width: 100%;
      background: #006fba;
      color: #ffffff;
      padding: 16px 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .header-inner {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .brand-area {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .logo {
      width: 58px;
      height: 58px;
      object-fit: contain;
      background: #ffffff;
      border-radius: 8px;
      padding: 4px;
      display: none;
      flex-shrink: 0;
    }

    .brand-text {
      min-width: 0;
    }

    .brand-title {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.2;
      margin: 0;
    }

    .brand-subtitle {
      font-size: 12px;
      margin-top: 4px;
      opacity: 0.92;
    }

    .header-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 7px 10px;
      border: 1px solid rgba(255,255,255,0.45);
      border-radius: 20px;
      white-space: nowrap;
    }


    /* =====================================================
       MAIN
       ===================================================== */

    .main {
      width: 100%;
      flex: 1;
      padding: 25px 15px 35px;
    }

    .container {
      width: 100%;
      max-width: 850px;
      margin: 0 auto;
    }


    /* =====================================================
       PAGE TITLE
       ===================================================== */

    .page-title {
      margin-bottom: 18px;
    }

    .page-title h1 {
      margin: 0;
      font-size: 25px;
      color: #24445c;
    }

    .page-title p {
      margin: 7px 0 0;
      color: #667781;
      font-size: 13px;
    }


    /* =====================================================
       SEARCH CARD
       ===================================================== */

    .search-card {
      background: #ffffff;
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.08);
      border: 1px solid #dce5ec;
      margin-bottom: 20px;
    }

    .field-label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: #24445c;
      margin-bottom: 8px;
    }

    .card-input {
      width: 100%;
      height: 52px;
      border: 2px solid #c9d5df;
      border-radius: 8px;
      padding: 0 15px;
      font-size: 20px;
      letter-spacing: 1px;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .card-input:focus {
      border-color: #006fba;
    }

    .input-help {
      margin-top: 7px;
      font-size: 11px;
      color: #77858e;
    }

    .button-row {
      display: flex;
      gap: 10px;
      margin-top: 15px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      border-radius: 8px;
      min-height: 45px;
      padding: 0 20px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-search {
      background: #006fba;
      color: #ffffff;
      flex: 1;
    }

    .btn-search:hover {
      background: #005d9d;
    }

    .btn-clear {
      background: #e9eef2;
      color: #24445c;
    }

    .btn-clear:hover {
      background: #dce4e9;
    }

    .btn-dashboard {
      background: #ffffff;
      color: #006fba;
      border: 1px solid #006fba;
    }

    .btn-dashboard:hover {
      background: #eef7fc;
    }


    /* =====================================================
       STATUS
       ===================================================== */

    .status {
      display: none;
      border-radius: 8px;
      padding: 13px 15px;
      margin-bottom: 18px;
      font-size: 13px;
      line-height: 1.4;
    }

    .status.loading {
      display: block;
      background: #eef7fc;
      border: 1px solid #b9dcef;
      color: #005d9d;
    }

    .status.error {
      display: block;
      background: #fff2f2;
      border: 1px solid #e5baba;
      color: #a00000;
    }

    .status.info {
      display: block;
      background: #f2f6fa;
      border: 1px solid #d4dfe8;
      color: #445b6b;
    }


    /* =====================================================
       RESULT
       ===================================================== */

    .result {
      display: none;
    }

    .result-card {
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #dce5ec;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .result-header {
      background: #006fba;
      color: #ffffff;
      padding: 15px 18px;
    }

    .result-header-title {
      font-size: 16px;
      font-weight: 700;
    }

    .result-header-subtitle {
      font-size: 11px;
      margin-top: 4px;
      opacity: 0.9;
    }


    /* =====================================================
       CARD NUMBER DISPLAY
       ===================================================== */

    .card-number-box {
      text-align: center;
      padding: 22px 15px;
      background: #f7fafc;
      border-bottom: 1px solid #dce5ec;
    }

    .card-number-label {
      font-size: 11px;
      color: #71808b;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .card-number {
      font-size: 25px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #006fba;
      word-break: break-word;
    }


    /* =====================================================
       INFORMATION TABLE
       ===================================================== */

    .section {
      padding: 18px;
    }

    .section-title {
      font-size: 13px;
      font-weight: 700;
      color: #24445c;
      margin-bottom: 10px;
      padding-bottom: 7px;
      border-bottom: 2px solid #006fba;
    }

    .info-table {
      width: 100%;
      border-collapse: collapse;
    }

    .info-table tr {
      border-bottom: 1px solid #e4eaef;
    }

    .info-table tr:last-child {
      border-bottom: none;
    }

    .info-table td {
      padding: 10px 9px;
      font-size: 12px;
      vertical-align: top;
    }

    .info-table td:first-child {
      width: 38%;
      font-weight: 700;
      color: #24445c;
      background: #f5f8fa;
    }

    .info-table td:last-child {
      color: #222;
      word-break: break-word;
    }


    /* =====================================================
       STATUS BADGE
       ===================================================== */

    .badge {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 700;
      background: #e8f5ec;
      color: #1d6b36;
    }


    /* =====================================================
       IMAGE
       ===================================================== */

    .image-container {
      width: 100%;
      text-align: center;
      padding-top: 8px;
    }

    .card-image {
      max-width: 100%;
      max-height: 420px;
      object-fit: contain;
      border-radius: 8px;
      border: 1px solid #d5dfe6;
      background: #f4f7fa;
      display: none;
    }

    .image-link {
      display: none;
      margin-top: 10px;
      font-size: 12px;
      font-weight: 700;
      color: #006fba;
      text-decoration: none;
    }

    .image-link:hover {
      text-decoration: underline;
    }


    /* =====================================================
       NOT FOUND
       ===================================================== */

    .not-found {
      display: none;
      background: #ffffff;
      border: 1px solid #e0e5e9;
      border-radius: 12px;
      padding: 30px 20px;
      text-align: center;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.06);
    }

    .not-found-icon {
      font-size: 42px;
      margin-bottom: 10px;
    }

    .not-found-title {
      font-size: 18px;
      font-weight: 700;
      color: #a00000;
    }

    .not-found-text {
      margin-top: 7px;
      font-size: 13px;
      color: #697983;
    }


    /* =====================================================
       FOOTER
       ===================================================== */

    .footer {
      width: 100%;
      text-align: center;
      padding: 18px 15px;
      color: #77858e;
      font-size: 11px;
      border-top: 1px solid #dce5ec;
      background: #ffffff;
    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 600px) {

      .header {
        padding: 13px 14px;
      }

      .header-inner {
        align-items: flex-start;
      }

      .logo {
        width: 48px;
        height: 48px;
      }

      .brand-title {
        font-size: 17px;
      }

      .brand-subtitle {
        font-size: 10px;
      }

      .header-badge {
        font-size: 9px;
        padding: 5px 7px;
      }

      .main {
        padding: 18px 10px 25px;
      }

      .page-title h1 {
        font-size: 21px;
      }

      .search-card {
        padding: 16px;
      }

      .card-input {
        font-size: 17px;
      }

      .button-row {
        flex-direction: column;
      }

      .btn-search,
      .btn-clear,
      .btn-dashboard {
        width: 100%;
        flex: none;
      }

      .card-number {
        font-size: 20px;
        letter-spacing: 1px;
      }

      .info-table td {
        font-size: 11px;
        padding: 9px 7px;
      }

      .info-table td:first-child {
        width: 42%;
      }

    }

  </style>

</head>


<body>

<div class="page">


  <!-- =====================================================
       HEADER
       ===================================================== -->

  <header class="header">

    <div class="header-inner">

      <div class="brand-area">

        <img
          id="companyLogo"
          class="logo"
          alt="Company Logo"
        >

        <div class="brand-text">

          <div class="brand-title">
            LBC-RPC PORTAL
          </div>

          <div class="brand-subtitle">
            Card Capture &amp; Registration System
          </div>

        </div>

      </div>

      <div class="header-badge">
        LOCATE CARD
      </div>

    </div>

  </header>


  <!-- =====================================================
       MAIN
       ===================================================== -->

  <main class="main">

    <div class="container">


      <!-- PAGE TITLE -->

      <div class="page-title">

        <h1>
          Locate Card
        </h1>

        <p>
          Search the CARD DATABASE using the 16-digit card number.
        </p>

      </div>


      <!-- =================================================
           SEARCH FORM
           ================================================= -->

      <div class="search-card">

        <label
          class="field-label"
          for="cardNumber"
        >
          Card Number
        </label>

        <input
          id="cardNumber"
          class="card-input"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          maxlength="19"
          placeholder="5000 0000 0898 7462"
          oninput="formatInputCardNumber()"
          onkeydown="handleKeyDown(event)"
        >

        <div class="input-help">
          Enter the complete 16-digit card number. Spaces are allowed.
        </div>


        <div class="button-row">

          <button
            type="button"
            class="btn-search"
            id="searchButton"
            onclick="searchCard()"
          >
            🔎 LOCATE CARD
          </button>

          <button
            type="button"
            class="btn-clear"
            onclick="clearSearch()"
          >
            CLEAR
          </button>

          <button
            type="button"
            class="btn-dashboard"
            onclick="openDashboard()"
          >
            ← DASHBOARD
          </button>

        </div>

      </div>


      <!-- =================================================
           STATUS
           ================================================= -->

      <div
        id="status"
        class="status"
      ></div>


      <!-- =================================================
           NOT FOUND
           ================================================= -->

      <div
        id="notFound"
        class="not-found"
      >

        <div class="not-found-icon">
          🔍
        </div>

        <div class="not-found-title">
          CARD NOT FOUND
        </div>

        <div
          id="notFoundText"
          class="not-found-text"
        >
          No record was found in the CARD DATABASE.
        </div>

      </div>


      <!-- =================================================
           RESULT
           ================================================= -->

      <div
        id="result"
        class="result"
      >

        <div class="result-card">


          <!-- RESULT HEADER -->

          <div class="result-header">

            <div class="result-header-title">
              CARD LOCATION RESULT
            </div>

            <div class="result-header-subtitle">
              Record retrieved from CARD DATABASE
            </div>

          </div>


          <!-- CARD NUMBER -->

          <div class="card-number-box">

            <div class="card-number-label">
              Card Number
            </div>

            <div
              id="resultCardNumber"
              class="card-number"
            >
              —
            </div>

          </div>


          <!-- REPORT INFORMATION -->

          <div class="section">

            <div class="section-title">
              REPORT INFORMATION
            </div>

            <table class="info-table">

              <tr>
                <td>Unique Report ID</td>
                <td id="resultUniqueId">—</td>
              </tr>

              <tr>
                <td>Timestamp</td>
                <td id="resultTimestamp">—</td>
              </tr>

              <tr>
                <td>Card Sequence</td>
                <td id="resultCardSequence">—</td>
              </tr>

              <tr>
                <td>Status</td>
                <td>
                  <span
                    id="resultStatus"
                    class="badge"
                  >
                    —
                  </span>
                </td>
              </tr>

            </table>

          </div>


          <!-- ORIGINATING LOCATION -->

          <div class="section">

            <div class="section-title">
              ORIGINATING LOCATION
            </div>

            <table class="info-table">

              <tr>
                <td>Store Code</td>
                <td id="resultStoreCode">—</td>
              </tr>

              <tr>
                <td>Store / Hub Name</td>
                <td id="resultStoreName">—</td>
              </tr>

              <tr>
                <td>Area</td>
                <td id="resultArea">—</td>
              </tr>

              <tr>
                <td>Processor / Submitted By</td>
                <td id="resultProcessor">—</td>
              </tr>

            </table>

          </div>


          <!-- TURN-OVER INFORMATION -->

          <div class="section">

            <div class="section-title">
              TURN-OVER INFORMATION
            </div>

            <table class="info-table">

              <tr>
                <td>Turn-over To</td>
                <td id="resultTurnoverType">—</td>
              </tr>

              <tr>
                <td>Destination Code</td>
                <td id="resultTurnoverCode">—</td>
              </tr>

              <tr>
                <td>Destination Location</td>
                <td id="resultTurnoverLocation">—</td>
              </tr>

            </table>

          </div>


          <!-- CARD IMAGE -->

          <div class="section">

            <div class="section-title">
              CAPTURED CARD IMAGE
            </div>

            <div class="image-container">

              <img
                id="cardImage"
                class="card-image"
                alt="Captured Card Image"
              >

              <a
                id="imageLink"
                class="image-link"
                href="#"
                target="_blank"
              >
                OPEN CARD IMAGE IN GOOGLE DRIVE
              </a>

            </div>

          </div>


        </div>

      </div>


    </div>

  </main>


  <!-- =====================================================
       FOOTER
       ===================================================== -->

  <footer
    id="footer"
    class="footer"
  >
    Develop by JMP 2026
  </footer>


</div>


<script>


  /* =====================================================
     INITIALIZATION
     ===================================================== */

  document.addEventListener(
    'DOMContentLoaded',
    function() {

      loadPortalData();

      document
        .getElementById('cardNumber')
        .focus();

    }
  );


  /* =====================================================
     LOAD PORTAL DATA
     ===================================================== */

  function loadPortalData() {

    google
      .script
      .run
      .withSuccessHandler(
        function(data) {

          if (!data) {
            return;
          }

          if (data.title) {

            document
              .querySelector('.brand-title')
              .textContent = data.title;

          }

          if (data.footer) {

            document
              .getElementById('footer')
              .textContent = data.footer;

          }

          if (data.logoUrl) {

            const logo =
              document.getElementById(
                'companyLogo'
              );

            logo.src = data.logoUrl;

            logo.style.display = 'block';

          }

        }
      )
      .withFailureHandler(
        function(error) {

          console.log(
            'Portal data error:',
            error
          );

        }
      )
      .getPortalData();

  }


  /* =====================================================
     FORMAT CARD NUMBER
     ===================================================== */

  function formatInputCardNumber() {

    const input =
      document.getElementById(
        'cardNumber'
      );

    let digits =
      input.value
        .replace(/\D/g, '')
        .substring(0, 16);


    let formatted = '';


    for (
      let i = 0;
      i < digits.length;
      i++
    ) {

      if (
        i > 0 &&
        i % 4 === 0
      ) {

        formatted += ' ';

      }

      formatted += digits.charAt(i);

    }


    input.value = formatted;

  }


  /* =====================================================
     KEYBOARD
     ===================================================== */

  function handleKeyDown(event) {

    if (
      event.key === 'Enter'
    ) {

      event.preventDefault();

      searchCard();

    }

  }


  /* =====================================================
     SEARCH CARD
     ===================================================== */

  function searchCard() {

    const input =
      document.getElementById(
        'cardNumber'
      );

    const number =
      input.value
        .replace(/\D/g, '')
        .substring(0, 16);


    hideResult();
    hideNotFound();
    clearStatus();


    if (!number) {

      showStatus(
        'Please enter a card number.',
        'error'
      );

      input.focus();

      return;

    }


    if (
      !/^\d{16}$/.test(number)
    ) {

      showStatus(
        'Please enter exactly 16 digits.',
        'error'
      );

      input.focus();

      return;

    }


    setSearching(true);


    showStatus(
      'Searching CARD DATABASE...',
      'loading'
    );


    google
      .script
      .run
      .withSuccessHandler(
        function(result) {

          setSearching(false);

          clearStatus();


          if (
            result &&
            result.found === true
          ) {

            displayResult(result);

          } else {

            displayNotFound(
              result
            );

          }

        }
      )
      .withFailureHandler(
        function(error) {

          setSearching(false);

          showStatus(
            getErrorMessage(error),
            'error'
          );

        }
      )
      .locateCard(number);

  }


  /* =====================================================
     DISPLAY RESULT
     ===================================================== */

  function displayResult(data) {

    hideNotFound();

    document
      .getElementById(
        'resultCardNumber'
      )
      .textContent =
        formatDisplayNumber(
          data.cardNumber
        );


    setText(
      'resultUniqueId',
      data.uniqueId
    );

    setText(
      'resultTimestamp',
      data.timestamp
    );

    setText(
      'resultCardSequence',
      data.cardSequence
        ? 'CARD ' + data.cardSequence
        : ''
    );

    setText(
      'resultStoreCode',
      data.storeCode
    );

    setText(
      'resultStoreName',
      data.storeName
    );

    setText(
      'resultArea',
      data.area
    );

    setText(
      'resultProcessor',
      data.processor
    );

    setText(
      'resultTurnoverType',
      data.turnoverType
    );

    setText(
      'resultTurnoverCode',
      data.turnoverCode
    );

    setText(
      'resultTurnoverLocation',
      data.turnoverLocation
    );


    const status =
      document.getElementById(
        'resultStatus'
      );

    status.textContent =
      data.status || 'REPORTED';


    /* =================================================
       IMAGE
       ================================================= */

    const image =
      document.getElementById(
        'cardImage'
      );

    const imageLink =
      document.getElementById(
        'imageLink'
      );


    image.style.display = 'none';
    imageLink.style.display = 'none';


    if (data.imageUrl) {

      image.src = data.imageUrl;

      image.onload =
        function() {

          image.style.display =
            'inline-block';

        };

      image.onerror =
        function() {

          image.style.display =
            'none';

        };


      imageLink.href =
        data.imageUrl;

      imageLink.style.display =
        'inline-block';

    }


    document
      .getElementById(
        'result'
      )
      .style.display = 'block';


    window.scrollTo({
      top:
        document
          .getElementById(
            'result'
          )
          .offsetTop - 15,

      behavior: 'smooth'

    });

  }


  /* =====================================================
     DISPLAY NOT FOUND
     ===================================================== */

  function displayNotFound(data) {

    hideResult();

    const text =
      document.getElementById(
        'notFoundText'
      );


    if (
      data &&
      data.message
    ) {

      text.textContent =
        data.message;

    } else {

      text.textContent =
        'No record was found in the CARD DATABASE.';

    }


    document
      .getElementById(
        'notFound'
      )
      .style.display = 'block';

  }


  /* =====================================================
     CLEAR SEARCH
     ===================================================== */

  function clearSearch() {

    document
      .getElementById(
        'cardNumber'
      )
      .value = '';


    hideResult();
    hideNotFound();
    clearStatus();


    document
      .getElementById(
        'cardNumber'
      )
      .focus();

  }


  /* =====================================================
     OPEN DASHBOARD
     ===================================================== */

  function openDashboard() {

    google
      .script
      .run
      .withSuccessHandler(
        function(url) {

          if (url) {

            window.top.location.href =
              url;

          }

        }
      )
      .withFailureHandler(
        function(error) {

          showStatus(
            getErrorMessage(error),
            'error'
          );

        }
      )
      .getDashboardUrl();

  }


  /* =====================================================
     UI HELPERS
     ===================================================== */

  function setText(
    id,
    value
  ) {

    document
      .getElementById(id)
      .textContent =
        value ||
        '—';

  }


  function formatDisplayNumber(
    number
  ) {

    const digits =
      String(number || '')
        .replace(/\D/g, '')
        .substring(0, 16);


    return digits.replace(
      /(\d{4})(?=\d)/g,
      '$1 '
    );

  }


  function showStatus(
    message,
    type
  ) {

    const status =
      document.getElementById(
        'status'
      );


    status.textContent =
      message || '';


    status.className =
      'status ' +
      (type || 'info');

  }


  function clearStatus() {

    const status =
      document.getElementById(
        'status'
      );


    status.textContent =
      '';

    status.className =
      'status';

  }


  function hideResult() {

    document
      .getElementById(
        'result'
      )
      .style.display = 'none';

  }


  function hideNotFound() {

    document
      .getElementById(
        'notFound'
      )
      .style.display = 'none';

  }


  function setSearching(
    searching
  ) {

    const button =
      document.getElementById(
        'searchButton'
      );


    if (searching) {

      button.disabled = true;

      button.textContent =
        '⏳ SEARCHING...';

      button.style.opacity =
        '0.7';

      button.style.cursor =
        'wait';

    } else {

      button.disabled = false;

      button.textContent =
        '🔎 LOCATE CARD';

      button.style.opacity =
        '1';

      button.style.cursor =
        'pointer';

    }

  }


  function getErrorMessage(
    error
  ) {

    if (!error) {

      return 'An unexpected error occurred.';

    }


    if (
      error.message
    ) {

      return error.message;

    }


    return String(error);

  }


</script>


</body>

</html>
