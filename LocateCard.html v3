
<!DOCTYPE html>
<html>


<head>


  <base target="_top">


  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  >


  <title>LBC-RPC PORTAL - Locate Card</title>


  <style>


    * {
      box-sizing: border-box;
    }


    body {

      margin: 0;

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      background: #f4f7fb;

      color: #1f2937;

    }


    /* =====================================================
       HEADER
       ===================================================== */

    .header {

      background: #0878c9;

      color: white;

      padding: 16px 24px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      box-shadow:
        0 2px 8px rgba(0,0,0,0.15);

    }


    .brand {

      display: flex;

      align-items: center;

      gap: 14px;

    }


    .logo {

      width: 55px;

      height: 55px;

      border-radius: 10px;

      object-fit: contain;

      background: white;

      padding: 4px;

      display: none;

    }


    .title {

      font-size: 24px;

      font-weight: 700;

      letter-spacing: .4px;

    }


    .subtitle {

      font-size: 13px;

      margin-top: 3px;

      opacity: .9;

    }


    .header-badge {

      font-size: 11px;

      font-weight: 700;

      padding: 7px 10px;

      border: 1px solid rgba(255,255,255,0.45);

      border-radius: 20px;

      white-space: nowrap;

      background: rgba(255,255,255,0.15);

    }


    /* =====================================================
       NAVIGATION
       ===================================================== */

    .navigation {

      background: white;

      border-bottom:
        1px solid #dbe3ec;

      display: flex;

      justify-content: center;

      gap: 5px;

      padding: 10px;

      position: sticky;

      top: 0;

      z-index: 50;

    }


    .nav-button {

      border: none;

      background: transparent;

      padding: 13px 22px;

      border-radius: 8px;

      font-size: 14px;

      font-weight: 600;

      color: #52606d;

      cursor: pointer;

    }


    .nav-button:hover {

      background: #eef6fd;

      color: #0878c9;

    }


    .nav-button.active {

      background: #0878c9;

      color: white;

    }


    /* =====================================================
       CONTAINER
       ===================================================== */

    .container {

      width: 100%;

      max-width: 1200px;

      margin: auto;

      padding: 25px;

    }


    .page-title {

      margin-bottom: 20px;

    }


    .page-title h1 {

      margin: 0;

      font-size: 24px;

    }


    .page-title p {

      margin: 7px 0 0;

      color: #6b7280;

      font-size: 14px;

    }


    /* =====================================================
       PANEL
       ===================================================== */

    .panel {

      background: white;

      border:
        1px solid #e1e8ef;

      border-radius: 12px;

      padding: 25px;

      margin-bottom: 20px;

      box-shadow:
        0 3px 10px rgba(0,0,0,.05);

    }


    .panel-title {

      font-size: 17px;

      font-weight: 700;

      color: #0878c9;

      margin-bottom: 20px;

      padding-bottom: 10px;

      border-bottom:
        1px solid #edf1f5;

    }


    /* =====================================================
       FORM
       ===================================================== */

    .form-grid {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 18px;

    }


    .form-group {

      display: flex;

      flex-direction: column;

    }


    .form-group.full {

      grid-column:
        1 / -1;

    }


    label {

      font-size: 13px;

      font-weight: 600;

      margin-bottom: 7px;

      color: #374151;

    }


    input,
    select {

      width: 100%;

      height: 44px;

      border:
        1px solid #cfd8e3;

      border-radius: 7px;

      padding:
        0 12px;

      font-size: 14px;

      background: white;

      outline: none;

    }


    input:focus,
    select:focus {

      border-color: #0878c9;

      box-shadow:
        0 0 0 2px
        rgba(8,120,201,.10);

    }


    .card-number-input {

      font-size: 20px;

      font-weight: 700;

      letter-spacing: 2px;

      text-align: center;

    }


    .input-help {

      margin-top: 8px;

      color: #6b7280;

      font-size: 12px;

    }


    /* =====================================================
       BUTTONS
       ===================================================== */

    .button {

      border: none;

      border-radius: 7px;

      padding: 12px 18px;

      font-size: 14px;

      font-weight: 600;

      cursor: pointer;

    }


    .button-primary {

      background: #0878c9;

      color: white;

    }


    .button-primary:hover {

      background: #066aaa;

    }


    .button-secondary {

      background: #eef3f7;

      color: #334155;

    }


    .button-secondary:hover {

      background: #e1e8ef;

    }


    .button-row {

      display: flex;

      gap: 10px;

      margin-top: 15px;

      flex-wrap: wrap;

    }


    /* =====================================================
       STATUS
       ===================================================== */

    .status {

      display: none;

      border-radius: 10px;

      padding: 18px;

      margin-bottom: 20px;

      font-size: 13px;

      line-height: 1.4;

    }


    .status.loading {

      display: block;

      background: #eef7fc;

      border:
        1px solid #b9dcef;

      color: #005d9d;

    }


    .status.error {

      display: block;

      background: #fff1f2;

      border:
        1px solid #fecdd3;

      color: #9f1239;

    }


    .status.info {

      display: block;

      background: #f2f6fa;

      border:
        1px solid #d4dfe8;

      color: #445b6b;

    }


    /* =====================================================
       RESULT
       ===================================================== */

    .result {

      display: none;

    }


    .result-card {

      background: white;

      border-radius: 12px;

      border:
        1px solid #e1e8ef;

      box-shadow:
        0 3px 10px rgba(0,0,0,.05);

      overflow: hidden;

    }


    .result-header {

      background: #0878c9;

      color: white;

      padding: 15px 18px;

    }


    .result-header-title {

      font-size: 16px;

      font-weight: 700;

    }


    .result-header-subtitle {

      font-size: 11px;

      margin-top: 4px;

      opacity: 0.9;

    }


    /* =====================================================
       CARD NUMBER DISPLAY
       ===================================================== */

    .card-number-box {

      text-align: center;

      padding: 22px 15px;

      background: #f7fafc;

      border-bottom:
        1px solid #edf1f5;

    }


    .card-number-label {

      font-size: 11px;

      color: #71808b;

      text-transform: uppercase;

      font-weight: 700;

      margin-bottom: 7px;

    }


    .card-number {

      font-size: 25px;

      font-weight: 700;

      letter-spacing: 2px;

      color: #0878c9;

      word-break: break-word;

    }


    /* =====================================================
       INFORMATION TABLE
       ===================================================== */

    .section {

      padding: 18px;

    }


    .section-title {

      font-size: 13px;

      font-weight: 700;

      color: #0878c9;

      margin-bottom: 10px;

      padding-bottom: 7px;

      border-bottom:
        2px solid #0878c9;

    }


    .info-table {

      width: 100%;

      border-collapse: collapse;

    }


    .info-table tr {

      border-bottom:
        1px solid #e4eaef;

    }


    .info-table tr:last-child {

      border-bottom: none;

    }


    .info-table td {

      padding: 10px 9px;

      font-size: 12px;

      vertical-align: top;

    }


    .info-table td:first-child {

      width: 38%;

      font-weight: 700;

      color: #24445c;

      background: #f5f8fa;

    }


    .info-table td:last-child {

      color: #222;

      word-break: break-word;

    }


    /* =====================================================
       STATUS BADGE
       ===================================================== */

    .badge {

      display: inline-block;

      padding: 5px 10px;

      border-radius: 20px;

      font-size: 10px;

      font-weight: 700;

      background: #e8f5ec;

      color: #1d6b36;

    }


    /* =====================================================
       IMAGE
       ===================================================== */

    .image-container {

      width: 100%;

      text-align: center;

      padding-top: 8px;

    }


    .card-image {

      max-width: 100%;

      max-height: 420px;

      object-fit: contain;

      border-radius: 8px;

      border:
        1px solid #d5dfe6;

      background: #f4f7fa;

      display: none;

    }


    .image-link {

      display: none;

      margin-top: 10px;

      font-size: 12px;

      font-weight: 700;

      color: #0878c9;

      text-decoration: none;

    }


    .image-link:hover {

      text-decoration: underline;

    }


    /* =====================================================
       CARD HISTORY
       ===================================================== */

    .card-history { width: 100%; }

    .history-empty {
      padding: 18px 12px;
      text-align: center;
      color: #7b8794;
      font-size: 12px;
      font-weight: 700;
      border: 1px dashed #d4dfe8;
      border-radius: 8px;
      background: #f8fafc;
    }

    .history-item {
      padding: 16px 0;
      border-bottom: 1px solid #e4eaef;
    }

    .history-item:first-child { padding-top: 4px; }
    .history-item:last-child { border-bottom: none; padding-bottom: 4px; }

    .history-title {
      font-size: 13px;
      font-weight: 700;
      color: #0878c9;
      margin-bottom: 9px;
    }

    .history-table { width: 100%; border-collapse: collapse; }

    .history-table td {
      padding: 6px 7px;
      font-size: 12px;
      vertical-align: top;
      border-bottom: 1px solid #f0f3f6;
    }

    .history-table tr:last-child td { border-bottom: none; }
    .history-table td:first-child { width: 32%; font-weight: 700; color: #52606d; }
    .history-table td:last-child { color: #222; word-break: break-word; }

    .history-status {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 700;
      background: #e8f5ec;
      color: #1d6b36;
    }

    /* =====================================================
       NOT FOUND
       ===================================================== */

    .not-found {

      display: none;

      background: #ffffff;

      border:
        1px solid #e0e5e9;

      border-radius: 12px;

      padding: 30px 20px;

      text-align: center;

      box-shadow:
        0 3px 10px rgba(0,0,0,.05);

    }


    .not-found-icon {

      font-size: 42px;

      margin-bottom: 10px;

    }


    .not-found-title {

      font-size: 18px;

      font-weight: 700;

      color: #dc3545;

    }


    .not-found-text {

      margin-top: 7px;

      font-size: 13px;

      color: #697983;

    }


    /* =====================================================
       FOOTER
       ===================================================== */

    footer {

      text-align: center;

      padding: 25px;

      color: #7b8794;

      font-size: 12px;

    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media screen and (max-width: 800px) {

      body {

        font-size: 16px;

        background: #f4f7fb;

      }


      /* HEADER */

      .header {

        padding: 14px 16px;

      }


      .brand {

        gap: 11px;

      }


      .logo {

        width: 48px;

        height: 48px;

      }


      .title {

        font-size: 20px;

        line-height: 1.25;

      }


      .subtitle {

        font-size: 13px;

        margin-top: 4px;

      }


      .header-badge {

        font-size: 9px;

        padding: 5px 7px;

      }


      /* CONTAINER */

      .container {

        width: 100%;

        max-width: 100%;

        padding: 18px 14px;

      }


      /* PAGE TITLE */

      .page-title {

        margin-bottom: 18px;

      }


      .page-title h1 {

        font-size: 24px;

        line-height: 1.25;

      }


      .page-title p {

        font-size: 15px;

        line-height: 1.5;

      }


      /* PANELS */

      .panel {

        width: 100%;

        padding: 18px 15px;

        margin-bottom: 18px;

        border-radius: 12px;

      }


      .panel-title {

        font-size: 18px;

        line-height: 1.35;

        margin-bottom: 18px;

        padding-bottom: 11px;

      }


      /* STRICT ONE COLUMN */

      .form-grid {

        display: grid !important;

        grid-template-columns: 1fr !important;

        gap: 16px !important;

        width: 100%;

      }


      .form-group {

        width: 100%;

        display: flex;

        flex-direction: column;

      }


      .form-group.full {

        grid-column: auto !important;

      }


      /* LABELS */

      label {

        font-size: 16px;

        line-height: 1.4;

        font-weight: 700;

        margin-bottom: 8px;

        color: #263342;

      }


      /* INPUTS */

      input,
      select {

        width: 94%;

        max-width: 94%;

        height: 50px;

        padding: 0 13px;

        font-size: 16px;

        line-height: 1.4;

        border-radius: 8px;

        border: 1px solid #c7d2de;

      }


      input::placeholder {

        font-size: 15px;

        color: #7a8794;

      }


      select {

        font-size: 16px;

      }


      /* CARD NUMBER INPUT */

      .card-number-input {

        width: 94%;

        max-width: 94%;

        height: 54px;

        font-size: 19px;

        font-weight: 700;

        letter-spacing: 2px;

        text-align: center;

      }


      /* BUTTONS */

      .button {

        min-height: 50px;

        padding: 12px 16px;

        font-size: 15px;

        line-height: 1.3;

        border-radius: 8px;

      }


      .button-row {

        display: grid;

        grid-template-columns: 1fr;

        gap: 10px;

        width: 94%;

        margin: 16px auto 0;

      }


      .button-row .button {

        width: 100%;

      }


      /* CARD NUMBER DISPLAY */

      .card-number {

        font-size: 20px;

        letter-spacing: 1px;

      }


      /* INFO TABLE */

      .info-table td {

        font-size: 11px;

        padding: 9px 7px;

      }


      .info-table td:first-child {

        width: 42%;

      }


      /* STATUS */

      .status {

        width: 100%;

        padding: 16px;

        font-size: 15px;

        line-height: 1.55;

      }


      /* NOT FOUND */

      .not-found {

        width: 100%;

        padding: 25px 15px;

      }


      /* FOOTER */

      footer {

        padding: 22px 15px;

        font-size: 13px;

      }

    }


    /* =====================================================
       VERY SMALL PHONES
       ===================================================== */

    @media screen and (max-width: 380px) {

      .container {

        padding: 15px 11px;

      }


      .panel {

        padding: 16px 13px;

      }


      .title {

        font-size: 18px;

      }


      .page-title h1 {

        font-size: 22px;

      }


      label {

        font-size: 15px;

      }


      input,
      select {

        width: 92%;

        max-width: 92%;

        font-size: 16px;

      }


      .button {

        font-size: 14px;

      }


      .card-number-input {

        font-size: 17px;

      }


      .card-number {

        font-size: 18px;

      }

    }

  </style>


</head>


<body>


<!-- =====================================================
     HEADER
     ===================================================== -->

<header class="header">

  <div class="brand">

    <img
      id="companyLogo"
      class="logo"
      alt="Company Logo"
    >

    <div>

      <div class="title">
        LBC-RPC PORTAL
      </div>

      <div class="subtitle">
        Locate Card
      </div>

    </div>

  </div>

  <div class="header-badge">
    LOCATE CARD
  </div>

</header>


<!-- =====================================================
     MAIN
     ===================================================== -->

<main class="container">


  <!-- PAGE TITLE -->

  <div class="page-title">

    <h1>
      Locate Card
    </h1>

    <p>
      Search the CARD DATABASE using the 16-digit card number.
    </p>

  </div>


  <!-- =====================================================
       SEARCH FORM
       ===================================================== -->

  <div class="panel">

    <div class="panel-title">
      CARD SEARCH
    </div>


    <div class="form-grid">

      <div class="form-group full">

        <label
          for="cardNumber"
        >
          Card Number
        </label>

        <input
          id="cardNumber"
          class="card-number-input"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          maxlength="19"
          placeholder="XXXX XXXX XXXX XXXX"
          oninput="formatInputCardNumber()"
          onkeydown="handleKeyDown(event)"
        >

        <div class="input-help">
          Enter the complete 16-digit card number. Spaces are allowed.
        </div>

      </div>

    </div>


    <div class="button-row">

      <button
        type="button"
        class="button button-primary"
        id="searchButton"
        onclick="searchCard()"
      >
        🔎 LOCATE CARD
      </button>

      <button
        type="button"
        class="button button-secondary"
        onclick="clearSearch()"
      >
        CLEAR
      </button>

      <button
        type="button"
        class="button button-secondary"
        onclick="openDashboard()"
      >
        ← DASHBOARD
      </button>

    </div>

  </div>


  <!-- =====================================================
       STATUS
       ===================================================== -->

  <div
    id="status"
    class="status"
  ></div>


  <!-- =====================================================
       NOT FOUND
       ===================================================== -->

  <div
    id="notFound"
    class="not-found"
  >

    <div class="not-found-icon">
      🔍
    </div>

    <div class="not-found-title">
      CARD NOT FOUND
    </div>

    <div
      id="notFoundText"
      class="not-found-text"
    >
      No record was found in the CARD DATABASE.
    </div>

  </div>


  <!-- =====================================================
       RESULT
       ===================================================== -->

  <div
    id="result"
    class="result"
  >

    <div class="result-card">

      <!-- RESULT HEADER -->

      <div class="result-header">

        <div class="result-header-title">
          CARD LOCATION RESULT
        </div>

        <div class="result-header-subtitle">
          Record retrieved from CARD DATABASE
        </div>

      </div>


      <!-- CARD NUMBER -->

      <div class="card-number-box">

        <div class="card-number-label">
          Card Number
        </div>

        <div
          id="resultCardNumber"
          class="card-number"
        >
          —
        </div>

      </div>


      <!-- REPORT INFORMATION -->

      <div class="section">

        <div class="section-title">
          REPORT INFORMATION
        </div>

        <table class="info-table">

          <tr>
            <td>Unique Report ID</td>
            <td id="resultUniqueId">—</td>
          </tr>

          <tr>
            <td>Timestamp</td>
            <td id="resultTimestamp">—</td>
          </tr>

          <tr>
            <td>Card Sequence</td>
            <td id="resultCardSequence">—</td>
          </tr>

          <tr>
            <td>Status</td>
            <td>
              <span
                id="resultStatus"
                class="badge"
              >
                —
              </span>
            </td>
          </tr>

        </table>

      </div>


      <!-- ORIGINATING LOCATION -->

      <div class="section">

        <div class="section-title">
          ORIGINATING LOCATION
        </div>

        <table class="info-table">

          <tr>
            <td>Store Code</td>
            <td id="resultStoreCode">—</td>
          </tr>

          <tr>
            <td>Store / Hub Name</td>
            <td id="resultStoreName">—</td>
          </tr>

          <tr>
            <td>Area</td>
            <td id="resultArea">—</td>
          </tr>

          <tr>
            <td>Processor / Submitted By</td>
            <td id="resultProcessor">—</td>
          </tr>

        </table>

      </div>


      <!-- TURN-OVER INFORMATION -->

      <div class="section">

        <div class="section-title">
          TURN-OVER INFORMATION
        </div>

        <table class="info-table">

          <tr>
            <td>Turn-over To</td>
            <td id="resultTurnoverType">—</td>
          </tr>

          <tr>
            <td>Destination Code</td>
            <td id="resultTurnoverCode">—</td>
          </tr>

          <tr>
            <td>Destination Location</td>
            <td id="resultTurnoverLocation">—</td>
          </tr>

        </table>

      </div>


      <!-- CARD IMAGE -->

      <div class="section">

        <div class="section-title">
          CAPTURED CARD IMAGE
        </div>

        <div class="image-container">

          <img
            id="cardImage"
            class="card-image"
            alt="Captured Card Image"
          >

          <a
            id="imageLink"
            class="image-link"
            href="#"
            target="_blank"
          >
            OPEN CARD IMAGE IN GOOGLE DRIVE
          </a>

        </div>

      </div>


      <!-- CARD HISTORY -->
      <div class="section">

        <div class="section-title">
          CARD HISTORY
        </div>

        <div id="cardHistory" class="card-history">
          <div class="history-empty">
            NO HISTORY AVAILABLE
          </div>
        </div>

      </div>
    </div>

  </div>


</main>


<!-- =====================================================
     FOOTER
     ===================================================== -->

<footer
  id="footer"
>
  Develop by JMP 2026
</footer>


<script>


  /* =====================================================
     INITIALIZATION
     ===================================================== */

  document.addEventListener(
    'DOMContentLoaded',
    function() {

      loadPortalData();

      document
        .getElementById('cardNumber')
        .focus();

    }
  );


  /* =====================================================
     LOAD PORTAL DATA
     ===================================================== */

  function loadPortalData() {

    google
      .script
      .run
      .withSuccessHandler(
        function(data) {

          if (!data) {
            return;
          }

          if (data.logoUrl) {

            const logo =
              document.getElementById(
                'companyLogo'
              );

            logo.src = data.logoUrl;

            logo.style.display = 'block';

          }

        }
      )
      .withFailureHandler(
        function(error) {

          console.log(
            'Portal data error:',
            error
          );

        }
      )
      .getPortalData();

  }


  /* =====================================================
     FORMAT CARD NUMBER
     ===================================================== */

  function formatInputCardNumber() {

    const input =
      document.getElementById(
        'cardNumber'
      );

    let digits =
      input.value
        .replace(/\D/g, '')
        .substring(0, 16);

    let formatted = '';

    for (
      let i = 0;
      i < digits.length;
      i++
    ) {

      if (
        i > 0 &&
        i % 4 === 0
      ) {

        formatted += ' ';

      }

      formatted += digits.charAt(i);

    }

    input.value = formatted;

  }


  /* =====================================================
     KEYBOARD
     ===================================================== */

  function handleKeyDown(event) {

    if (
      event.key === 'Enter'
    ) {

      event.preventDefault();

      searchCard();

    }

  }


  /* =====================================================
     SEARCH CARD
     ===================================================== */

  function searchCard() {

    const input =
      document.getElementById(
        'cardNumber'
      );

    const number =
      input.value
        .replace(/\D/g, '')
        .substring(0, 16);

    hideResult();
    hideNotFound();
    clearStatus();

    if (!number) {

      showStatus(
        'Please enter a card number.',
        'error'
      );

      input.focus();

      return;

    }

    if (
      !/^\d{16}$/.test(number)
    ) {

      showStatus(
        'Please enter exactly 16 digits.',
        'error'
      );

      input.focus();

      return;

    }

    setSearching(true);

    showStatus(
      'Searching CARD DATABASE...',
      'loading'
    );

    google
      .script
      .run
      .withSuccessHandler(
        function(result) {

          setSearching(false);
          clearStatus();

          if (
            result &&
            result.found === true
          ) {

            displayResult(result);

          } else {

            displayNotFound(
              result
            );

          }

        }
      )
      .withFailureHandler(
        function(error) {

          setSearching(false);

          showStatus(
            getErrorMessage(error),
            'error'
          );

        }
      )
      .locateCard(number);

  }


  /* =====================================================
     DISPLAY RESULT
     ===================================================== */

  function displayResult(data) {

    hideNotFound();

    document
      .getElementById(
        'resultCardNumber'
      )
      .textContent =
        formatDisplayNumber(
          data.cardNumber
        );

    setText(
      'resultUniqueId',
      data.uniqueId
    );

    setText(
      'resultTimestamp',
      data.timestamp
    );

    setText(
      'resultCardSequence',
      data.cardSequence
        ? 'CARD ' + data.cardSequence
        : ''
    );

    setText(
      'resultStoreCode',
      data.storeCode
    );

    setText(
      'resultStoreName',
      data.storeName
    );

    setText(
      'resultArea',
      data.area
    );

    setText(
      'resultProcessor',
      data.processor
    );

    setText(
      'resultTurnoverType',
      data.turnoverType
    );

    setText(
      'resultTurnoverCode',
      data.turnoverCode
    );

    setText(
      'resultTurnoverLocation',
      data.turnoverLocation
    );

    const status =
      document.getElementById(
        'resultStatus'
      );

    status.textContent =
      data.status || 'REPORTED';

    renderCardHistory(data.history || []);

    /* =================================================
       IMAGE
       ================================================= */

    const image =
      document.getElementById(
        'cardImage'
      );

    const imageLink =
      document.getElementById(
        'imageLink'
      );

    image.style.display = 'none';
    imageLink.style.display = 'none';

    if (data.imageUrl) {

      image.src = data.imageUrl;

      image.onload =
        function() {

          image.style.display =
            'inline-block';

        };

      image.onerror =
        function() {

          image.style.display =
            'none';

        };

      imageLink.href =
        data.imageUrl;

      imageLink.style.display =
        'inline-block';

    }

    document
      .getElementById(
        'result'
      )
      .style.display = 'block';

    window.scrollTo({
      top:
        document
          .getElementById(
            'result'
          )
          .offsetTop - 15,

      behavior: 'smooth'

    });

  }


  /* =====================================================
     RENDER CARD HISTORY
     ===================================================== */

  function renderCardHistory(history) {
    const container = document.getElementById('cardHistory');
    if (!container) return;

    if (!Array.isArray(history) || history.length === 0) {
      container.innerHTML = '<div class="history-empty">NO HISTORY AVAILABLE</div>';
      return;
    }

    const records = history.slice().sort(function(a, b) {
      return parseHistoryDate(b && b.eventDateTime) - parseHistoryDate(a && a.eventDateTime);
    });

    container.innerHTML = records.map(function(item, index) {
      const eventType = String(item.eventType || '').trim();
      const status = String(item.status || '').trim();
      const title = eventType || status || 'CARD EVENT';

      return `
        <div class="history-item">
          <div class="history-title">${index + 1}. ${escapeHtml(title)}</div>
          <table class="history-table">
            <tr><td>Date / Time</td><td>${escapeHtml(item.eventDateTime || '—')}</td></tr>
            <tr><td>Status</td><td><span class="history-status">${escapeHtml(status || '—')}</span></td></tr>
            <tr><td>From</td><td>${escapeHtml(item.fromLocation || '—')}</td></tr>
            <tr><td>To</td><td>${escapeHtml(item.toLocation || '—')}</td></tr>
            <tr><td>Processor</td><td>${escapeHtml(item.processorUser || '—')}</td></tr>
            ${item.releasedTo ? `<tr><td>Released To</td><td>${escapeHtml(item.releasedTo)}</td></tr>` : ''}
            ${item.remarks ? `<tr><td>Remarks</td><td>${escapeHtml(item.remarks)}</td></tr>` : ''}
          </table>
        </div>
      `;
    }).join('');
  }

  function parseHistoryDate(value) {
    if (!value) return 0;
    const direct = new Date(value).getTime();
    if (!isNaN(direct)) return direct;
    const normalized = String(value).replace(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/, '$3-$1-$2');
    const parsed = new Date(normalized).getTime();
    return isNaN(parsed) ? 0 : parsed;
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  /* =====================================================
     DISPLAY NOT FOUND
     ===================================================== */

  function displayNotFound(data) {

    hideResult();

    const text =
      document.getElementById(
        'notFoundText'
      );

    if (
      data &&
      data.message
    ) {

      text.textContent =
        data.message;

    } else {

      text.textContent =
        'No record was found in the CARD DATABASE.';

    }

    document
      .getElementById(
        'notFound'
      )
      .style.display = 'block';

  }


  /* =====================================================
     CLEAR SEARCH
     ===================================================== */

  function clearSearch() {

    document
      .getElementById(
        'cardNumber'
      )
      .value = '';

    hideResult();
    hideNotFound();
    clearStatus();

    document
      .getElementById(
        'cardNumber'
      )
      .focus();

  }


  /* =====================================================
     OPEN DASHBOARD
     ===================================================== */

  function openDashboard() {

    google
      .script
      .run
      .withSuccessHandler(
        function(url) {

          if (url) {

            window.top.location.href =
              url;

          }

        }
      )
      .withFailureHandler(
        function(error) {

          showStatus(
            getErrorMessage(error),
            'error'
          );

        }
      )
      .getDashboardUrl();

  }


  /* =====================================================
     UI HELPERS
     ===================================================== */

  function setText(
    id,
    value
  ) {

    document
      .getElementById(id)
      .textContent =
        value ||
        '—';

  }


  function formatDisplayNumber(
    number
  ) {

    const digits =
      String(number || '')
        .replace(/\D/g, '')
        .substring(0, 16);

    return digits.replace(
      /(\d{4})(?=\d)/g,
      '$1 '
    );

  }


  function showStatus(
    message,
    type
  ) {

    const status =
      document.getElementById(
        'status'
      );

    status.textContent =
      message || '';

    status.className =
      'status ' +
      (type || 'info');

  }


  function clearStatus() {

    const status =
      document.getElementById(
        'status'
      );

    status.textContent =
      '';

    status.className =
      'status';

  }


  function hideResult() {

    document
      .getElementById(
        'result'
      )
      .style.display = 'none';

  }


  function hideNotFound() {

    document
      .getElementById(
        'notFound'
      )
      .style.display = 'none';

  }


  function setSearching(
    searching
  ) {

    const button =
      document.getElementById(
        'searchButton'
      );

    if (searching) {

      button.disabled = true;

      button.textContent =
        '⏳ SEARCHING...';

      button.style.opacity =
        '0.7';

      button.style.cursor =
        'wait';

    } else {

      button.disabled = false;

      button.textContent =
        '🔎 LOCATE CARD';

      button.style.opacity =
        '1';

      button.style.cursor =
        'pointer';

    }

  }


  function getErrorMessage(
    error
  ) {

    if (!error) {

      return 'An unexpected error occurred.';

    }

    if (
      error.message
    ) {

      return error.message;

    }

    return String(error);

  }

</script>


