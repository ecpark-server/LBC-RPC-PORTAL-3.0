<script>


/* =====================================================
   GLOBAL VARIABLES
   ===================================================== */

let portalData = null;

let cardRecords = [];

let ocrQueue = [];

let ocrQueueRunning = false;


/* =====================================================
   CAMERA CONFIGURATION
   ===================================================== */

const CAMERA_CAPTURE_URL =
  'https://ecpark-server.github.io/lbc-rpc-camera/CameraCapture.html';

let cameraWindow = null;

let cameraRequestId = '';

let cameraTargetIndex = -1;


const MAX_CARDS = 50;


/* =====================================================
   INITIALIZATION
   ===================================================== */

document.addEventListener(
  'DOMContentLoaded',
  function() {

    loadPortalData();

    addEmptyCard();

  }
);


/* =====================================================
   LOAD PORTAL DATA
   ===================================================== */

function loadPortalData() {

  google.script.run

    .withSuccessHandler(
      function(data) {

        portalData = data;

        populateStores();

        populateBSCs();


        if (data.logoUrl) {

          const logo =
            document.getElementById('companyLogo');

          const placeholder =
            document.getElementById('logoPlaceholder');


          logo.src = data.logoUrl;

          logo.style.display = 'block';

          placeholder.style.display = 'none';

        }


        generateReportId();

      }
    )

    .withFailureHandler(
      function(error) {

        showError(
          error.message ||
          'Unable to load portal data.'
        );

      }
    )

    .getPortalData();

}


/* =====================================================
   GENERATE REPORT ID
   ===================================================== */

function generateReportId() {

  document.getElementById('reportId')
    .textContent = 'GENERATING...';


  google.script.run

    .withSuccessHandler(
      function(id) {

        document.getElementById('reportId')
          .textContent = id;

      }
    )

    .withFailureHandler(
      function(error) {

        document.getElementById('reportId')
          .textContent = 'ERROR';


        showError(
          error.message ||
          'Unable to generate Report ID.'
        );

      }
    )

    .generateRPCUniqueId();

}


/* =====================================================
   POPULATE STORES
   ===================================================== */

function populateStores() {

  const select =
    document.getElementById('storeCode');


  select.innerHTML =
    '<option value="">Select Store Code</option>';


  portalData.stores.forEach(
    function(store) {

      const option =
        document.createElement('option');


      option.value =
        store.storeCode;


      option.textContent =
        store.storeCode +
        ' - ' +
        store.storeName;


      select.appendChild(option);

    }
  );

}


/* =====================================================
   POPULATE BSC
   ===================================================== */

function populateBSCs() {

  const select =
    document.getElementById('bscCode');


  select.innerHTML =
    '<option value="">Select BSC</option>';


  portalData.bscs.forEach(
    function(bsc) {

      const option =
        document.createElement('option');


      option.value =
        bsc.storeCode;


      option.textContent =
        bsc.storeCode +
        ' - ' +
        bsc.storeName;


      select.appendChild(option);

    }
  );

}


/* =====================================================
   STORE CHANGE
   ===================================================== */

function storeChanged() {

  const code =
    document.getElementById('storeCode').value;


  const record =
    portalData.stores.find(
      function(store) {

        return String(store.storeCode) ===
               String(code);

      }
    );


  document.getElementById('storeName').value =
    record ? record.storeName : '';


  document.getElementById('area').value =
    record ? record.area : '';


  document.getElementById('sameStoreCode').value =
    record ? record.storeCode : '';


  document.getElementById('sameStoreName').value =
    record ? record.storeName : '';

}


/* =====================================================
   TURNOVER CHANGE
   ===================================================== */

function turnoverChanged() {

  const type =
    document.querySelector(
      'input[name="turnoverType"]:checked'
    );


  document.getElementById('sameStoreBox')
    .classList.remove('show');


  document.getElementById('bscBox')
    .classList.remove('show');


  if (!type) return;


  if (type.value === 'SAME STORE') {

    const store =
      document.getElementById('storeCode').value;


    if (store) {

      storeChanged();

    }


    document.getElementById('sameStoreBox')
      .classList.add('show');

  }

  else {

    document.getElementById('bscBox')
      .classList.add('show');

  }

}


/* =====================================================
   BSC CHANGE
   ===================================================== */

function bscChanged() {

  const code =
    document.getElementById('bscCode').value;


  const record =
    portalData.bscs.find(
      function(bsc) {

        return String(bsc.storeCode) ===
               String(code);

      }
    );


  document.getElementById('bscName').value =
    record ? record.storeName : '';

}


/* =====================================================
   CARD OBJECT
   ===================================================== */

function createEmptyCardRecord() {

  return {

    file: null,

    dataUrl: '',

    cardNumber: '',

    ocrRawText: '',

    status: 'Waiting for image...',

    ocrBusy: false,

    ocrProgress: 0,

    validated: false

  };

}


/* =====================================================
   ADD EMPTY CARD
   ===================================================== */

function addEmptyCard() {

  if (cardRecords.length >= MAX_CARDS) {

    showError(
      'Maximum of ' +
      MAX_CARDS +
      ' cards per report.'
    );

    return;

  }


  cardRecords.push(
    createEmptyCardRecord()
  );


  renderCards();

}


/* =====================================================
   ADD CAMERA CARD
   ===================================================== */

function addCameraCard() {

  let target =
    cardRecords.findIndex(
      function(c) {
        return !c.file;
      }
    );


  if (target < 0) {

    if (cardRecords.length >= MAX_CARDS) {

      showError(
        'Maximum of ' +
        MAX_CARDS +
        ' cards per report.'
      );

      return;

    }


    cardRecords.push(
      createEmptyCardRecord()
    );


    target =
      cardRecords.length - 1;


    renderCards();

  }


  openCamera(target);

}


/* =====================================================
   MULTI UPLOAD
   ===================================================== */

function openMultiUpload() {

  const input =
    document.getElementById('multiImageInput');


  input.value = '';

  input.click();

}


/* =====================================================
   CAMERA INPUT FALLBACK
   ===================================================== */

function cameraSelected(input) {

  if (
    !input.files ||
    !input.files.length
  ) return;


  const index =
    Number(
      input.dataset.targetIndex || 0
    );


  setCardFile(
    index,
    input.files[0]
  );

}


/* =====================================================
   MULTIPLE IMAGE SELECTION
   ===================================================== */

function multiImagesSelected(input) {

  if (
    !input.files ||
    !input.files.length
  ) return;


  const files =
    Array.from(input.files);


  let nextIndex =
    cardRecords.findIndex(
      function(c) {
        return !c.file;
      }
    );


  if (nextIndex < 0) {

    nextIndex =
      cardRecords.length;

  }


  files.forEach(
    function(file) {

      if (nextIndex >= MAX_CARDS) {
        return;
      }


      if (!cardRecords[nextIndex]) {

        cardRecords.push(
          createEmptyCardRecord()
        );

      }


      setCardFile(
        nextIndex,
        file
      );


      nextIndex++;

    }
  );


  input.value = '';

}


/* =====================================================
   OPEN CAMERA
   ===================================================== */

function openCamera(index) {

  cameraTargetIndex = index;


  cameraRequestId =
    'RPC-CAM-' +
    Date.now() +
    '-' +
    Math.random()
      .toString(36)
      .substring(2, 9);


  const returnOrigin =
    window.location.origin;


  const cameraUrl =
    CAMERA_CAPTURE_URL +
    '?requestId=' +
    encodeURIComponent(cameraRequestId) +
    '&returnOrigin=' +
    encodeURIComponent(returnOrigin);


  cameraWindow =
    window.open(
      cameraUrl,
      'LBCRPCCameraCapture',
      'popup=yes,width=560,height=820,resizable=yes,scrollbars=yes'
    );


  if (!cameraWindow) {

    showError(
      'The Camera Capture window was blocked by your browser. Please allow pop-ups for this LBC-RPC Portal, then click CAPTURE again.'
    );


    cameraTargetIndex = -1;

    return;

  }


  cardRecords[index].status =
    'Camera opened. Capture the card in the camera window...';


  renderCards();

}


/* =====================================================
   CAMERA MESSAGE
   ===================================================== */

function handleCameraMessage(event) {

  if (
    !cameraWindow ||
    event.source !== cameraWindow
  ) return;


  if (
    !event.data ||
    typeof event.data !== 'object'
  ) return;


  const message =
    event.data;


  if (
    message.requestId !==
    cameraRequestId
  ) return;


  if (
    message.type ===
    'LBC_RPC_CAMERA_CANCEL'
  ) {

    if (
      cameraTargetIndex >= 0 &&
      cardRecords[cameraTargetIndex] &&
      !cardRecords[cameraTargetIndex].file
    ) {

      cardRecords[cameraTargetIndex].status =
        'Camera capture cancelled.';


      renderCards();

    }


    cameraTargetIndex = -1;

    cameraRequestId = '';

    cameraWindow = null;

    return;

  }


  if (
    message.type !==
    'LBC_RPC_CAMERA_CAPTURE'
  ) return;


  const index =
    cameraTargetIndex;


  if (
    index < 0 ||
    !cardRecords[index]
  ) return;


  if (!message.imageData) {

    showError(
      'The camera returned no image data. Please capture the card again.'
    );

    return;

  }


  try {

    const blob =
      dataUrlToBlob(
        message.imageData
      );


    const filename =
      message.imageName ||
      (
        'LBC-RPC-CARD-' +
        Date.now() +
        '.jpg'
      );


    const file =
      new File(
        [blob],
        filename,
        {
          type:
            blob.type ||
            'image/jpeg'
        }
      );


    cardRecords[index].status =
      'Captured. Loading image and starting OCR...';


    setCardFile(
      index,
      file
    );

  }

  catch (error) {

    showError(
      'Unable to receive the captured card image. Please try again.'
    );

  }


  cameraTargetIndex = -1;

  cameraRequestId = '';

  cameraWindow = null;

}


/* =====================================================
   DATA URL TO BLOB
   ===================================================== */

function dataUrlToBlob(dataUrl) {

  const parts =
    String(dataUrl).split(',');


  if (parts.length !== 2) {

    throw new Error(
      'Invalid camera image data.'
    );

  }


  const mimeMatch =
    parts[0].match(
      /data:([^;]+);base64/i
    );


  const mime =
    mimeMatch ?
    mimeMatch[1] :
    'image/jpeg';


  const binary =
    atob(parts[1]);


  const bytes =
    new Uint8Array(
      binary.length
    );


  for (
    let i = 0;
    i < binary.length;
    i++
  ) {

    bytes[i] =
      binary.charCodeAt(i);

  }


  return new Blob(
    [bytes],
    {
      type: mime
    }
  );

}


/* =====================================================
   RECEIVE CAMERA CAPTURE
   ===================================================== */

window.addEventListener(
  'message',
  handleCameraMessage,
  false
);


/* =====================================================
   CLOSE CAMERA
   ===================================================== */

function closeCamera() {

  if (
    cameraWindow &&
    !cameraWindow.closed
  ) {

    try {

      cameraWindow.close();

    }

    catch (e) {}

  }


  cameraWindow = null;

  cameraRequestId = '';

  cameraTargetIndex = -1;

}


/* =====================================================
   CAMERA COMPATIBILITY
   ===================================================== */

function takeCameraPhoto() {

  if (cameraTargetIndex >= 0) {

    openCamera(
      cameraTargetIndex
    );

  }

  else {

    addCameraCard();

  }

}


/* =====================================================
   SET CARD FILE
   ===================================================== */

function setCardFile(index, file) {

  if (!cardRecords[index]) return;


  cardRecords[index].file =
    file;


  cardRecords[index].dataUrl =
    '';


  cardRecords[index].cardNumber =
    '';


  cardRecords[index].ocrRawText =
    '';


  cardRecords[index].validated =
    false;


  cardRecords[index].status =
    'Loading image...';


  renderCards();


  const reader =
    new FileReader();


  reader.onload =
    function(event) {

      cardRecords[index].dataUrl =
        event.target.result;


      cardRecords[index].status =
        'Image loaded. OCR starting automatically...';


      renderCards();


      queueCardOCR(index);

    };


  reader.onerror =
    function() {

      cardRecords[index].status =
        'Unable to read image.';


      renderCards();

    };


  reader.readAsDataURL(file);

}


/* =====================================================
   OCR QUEUE
   ===================================================== */

function queueCardOCR(index) {

  if (
    ocrQueue.indexOf(index) === -1
  ) {

    ocrQueue.push(index);

  }


  processOCRQueue();

}


/* =====================================================
   PROCESS OCR QUEUE
   ===================================================== */

async function processOCRQueue() {

  if (ocrQueueRunning) return;


  ocrQueueRunning = true;


  try {

    while (ocrQueue.length) {

      const index =
        ocrQueue.shift();


      if (
        !cardRecords[index] ||
        !cardRecords[index].file ||
        !cardRecords[index].dataUrl
      ) {

        continue;

      }


      await runCardOCR(index);

    }

  }

  finally {

    ocrQueueRunning = false;

  }

}


/* =====================================================
   FORMAT DISPLAY CARD NUMBER
   Backend remains unformatted 16 digits.
   ===================================================== */

function formatCardNumberDisplay(value) {

  const digits =
    String(value || '')
      .replace(/\D/g, '')
      .substring(0, 16);

  return digits.replace(
    /(\d{4})(?=\d)/g,
    '$1 '
  ).trim();

}


/* =====================================================
   RENDER CARDS
   ===================================================== */

function renderCards() {

  const container =
    document.getElementById('cardList');


  container.innerHTML = '';


  if (!cardRecords.length) {

    container.innerHTML =
      '<div class="card-empty">' +
      'No card added yet. Capture or upload a card image.' +
      '</div>';

    return;

  }


  cardRecords.forEach(
    function(card, index) {

      const wrapper =
        document.createElement('div');


      wrapper.className =
        'card-item';


      /* HEADER */

      const header =
        document.createElement('div');


      header.className =
        'card-item-header';


      const title =
        document.createElement('div');


      title.className =
        'card-item-title';


      title.textContent =
        'CARD ' +
        (index + 1);


      header.appendChild(title);


      const actions =
        document.createElement('div');


      actions.className =
        'card-actions';


      /* CAPTURE */

      const cameraBtn =
        document.createElement('button');


      cameraBtn.type =
        'button';


      cameraBtn.className =
        'button button-primary';


      cameraBtn.textContent =
        '📷 CAPTURE';


      cameraBtn.onclick =
        function() {

          captureForCard(index);

        };


      actions.appendChild(
        cameraBtn
      );


      /* UPLOAD */

      const uploadBtn =
        document.createElement('button');


      uploadBtn.type =
        'button';


      uploadBtn.className =
        'button button-secondary';


      uploadBtn.textContent =
        '📁 UPLOAD';


      uploadBtn.onclick =
        function() {

          uploadForCard(index);

        };


      actions.appendChild(
        uploadBtn
      );


      /* REMOVE */

      if (
        cardRecords.length > 1
      ) {

        const removeBtn =
          document.createElement('button');


        removeBtn.type =
          'button';


        removeBtn.className =
          'button button-danger remove-card';


        removeBtn.textContent =
          'REMOVE';


        removeBtn.onclick =
          function() {

            removeCard(index);

          };


        actions.appendChild(
          removeBtn
        );

      }


      header.appendChild(
        actions
      );


      wrapper.appendChild(
        header
      );


      /* IMAGE PREVIEW */

      if (card.dataUrl) {

        const preview =
          document.createElement('div');


        preview.className =
          'card-preview-wrap';


        const img =
          document.createElement('img');


        img.className =
          'card-preview';


        img.src =
          card.dataUrl;


        img.alt =
          'Card ' +
          (index + 1) +
          ' Preview';


        preview.appendChild(
          img
        );


        wrapper.appendChild(
          preview
        );

      }

      else {

        const empty =
          document.createElement('div');


        empty.className =
          'card-empty';


        empty.textContent =
          'Capture or upload this card image.';


        wrapper.appendChild(
          empty
        );

      }


      /* OCR */

      const ocr =
        document.createElement('div');


      ocr.className =
        'ocr-section';


      const label =
        document.createElement('label');


      label.textContent =
        '16-Digit Card Number';


      ocr.appendChild(
        label
      );


      const input =
        document.createElement('input');


      input.className =
        'card-number-input';


      input.type =
        'text';


      input.inputMode =
        'numeric';


      input.maxLength =
        19;


      input.autocomplete =
        'off';


      input.placeholder =
        'XXXX XXXX XXXX XXXX';


      input.value =
        formatCardNumberDisplay(
          card.cardNumber
        );


      input.oninput =
        function() {

          const digits =
            input.value
              .replace(/\D/g, '')
              .substring(0, 16);


          cardRecords[index].cardNumber =
            digits;


          input.value =
            formatCardNumberDisplay(
              digits
            );


          cardRecords[index].validated =
            false;


          if (
            cardRecords[index].cardNumber.length === 16
          ) {

            cardRecords[index].status =
              '16 digits entered. Please validate the card number.';

          }

          else {

            cardRecords[index].status =
              'Please review the OCR result or enter the correct 16-digit number.';

          }


          renderCards();


          setTimeout(
            function() {

              const cards =
                document.querySelectorAll(
                  '.card-number-input'
                );


              if (cards[index]) {

                cards[index].focus();


                cards[index].setSelectionRange(
                  cards[index].value.length,
                  cards[index].value.length
                );

              }

            },
            0
          );

        };


      ocr.appendChild(
        input
      );


      /* STATUS */

      const status =
        document.createElement('div');


      status.className =
        'ocr-status';


      status.textContent =
        card.status;


      ocr.appendChild(
        status
      );


      /* PROGRESS */

      const progress =
        document.createElement('div');


      progress.className =
        'ocr-progress' +
        (
          card.ocrBusy ?
          ' show' :
          ''
        );


      const bar =
        document.createElement('div');


      bar.className =
        'ocr-progress-bar';


      bar.style.width =
        card.ocrProgress ?
        card.ocrProgress + '%' :
        '0%';


      progress.appendChild(
        bar
      );


      ocr.appendChild(
        progress
      );


      /* VALIDATION */

      const validationRow =
        document.createElement('div');


      validationRow.className =
        'validation-row';


      const validateBtn =
        document.createElement('button');


      validateBtn.type =
        'button';


      validateBtn.className =
        'button button-success';


      validateBtn.textContent =
        card.validated ?
        '✓ CARD NUMBER VALIDATED' :
        '✓ VALIDATE CARD NUMBER';


      validateBtn.disabled =
        card.ocrBusy ||
        !/^\d{16}$/.test(
          card.cardNumber
        );


      validateBtn.onclick =
        function() {

          validateCardNumber(index);

        };


      validationRow.appendChild(
        validateBtn
      );


      const badge =
        document.createElement('span');


      badge.className =
        'validation-badge ' +
        (
          card.validated
          ? 'valid'
          : (
              /^\d{16}$/.test(
                card.cardNumber
              )
              ? 'invalid'
              : ''
            )
        );


      badge.textContent =
        card.validated
        ? 'VALIDATED'
        : (
            /^\d{16}$/.test(
              card.cardNumber
            )
            ? 'REVIEW REQUIRED'
            : '16 DIGITS REQUIRED'
          );


      validationRow.appendChild(
        badge
      );


      ocr.appendChild(
        validationRow
      );


      wrapper.appendChild(
        ocr
      );


      container.appendChild(
        wrapper
      );

    }
  );

}


/* =====================================================
   CAPTURE FOR CARD
   ===================================================== */

function captureForCard(index) {

  openCamera(index);

}


/* =====================================================
   UPLOAD FOR CARD
   ===================================================== */

function uploadForCard(index) {

  const input =
    document.createElement('input');


  input.type =
    'file';


  input.accept =
    'image/*';


  input.multiple =
    false;


  input.onchange =
    function() {

      if (
        input.files &&
        input.files[0]
      ) {

        setCardFile(
          index,
          input.files[0]
        );

      }

    };


  input.click();

}


/* =====================================================
   REMOVE CARD
   ===================================================== */

function removeCard(index) {

  if (
    !confirm(
      'Remove Card ' +
      (index + 1) +
      ' from this report?'
    )
  ) {

    return;

  }


  cardRecords.splice(
    index,
    1
  );


  ocrQueue =
    ocrQueue
      .filter(
        function(i) {
          return i !== index;
        }
      )
      .map(
        function(i) {
          return i > index ?
            i - 1 :
            i;
        }
      );


  if (!cardRecords.length) {

    addEmptyCard();

  }


  renderCards();

}


/* =====================================================
   VALIDATE CARD NUMBER
   ===================================================== */

function validateCardNumber(index) {

  const card =
    cardRecords[index];


  if (!card) return;


  const number =
    String(
      card.cardNumber || ''
    )
    .replace(/\D/g, '');


  if (
    !/^\d{16}$/.test(number)
  ) {

    card.validated =
      false;


    card.status =
      'Validation failed. Card number must contain exactly 16 digits.';


    renderCards();

    return;

  }


  card.cardNumber =
    number;


  card.validated =
    true;


  card.status =
    'Card number validated and ready for submission.';


  renderCards();

}


/* =====================================================
   OCR
   ===================================================== */

async function runCardOCR(index) {

  const card =
    cardRecords[index];


  if (
    !card ||
    !card.file ||
    !card.dataUrl
  ) return;


  if (card.ocrBusy) return;


  card.ocrBusy =
    true;


  card.ocrProgress =
    5;


  card.validated =
    false;


  card.status =
    'Initializing OCR...';


  renderCards();


  try {

    const result =
      await Tesseract.recognize(
        card.file,
        'eng',
        {
          logger:
            function(message) {

              if (
                message.status ===
                'recognizing text'
              ) {

                card.ocrProgress =
                  Math.round(
                    (
                      message.progress ||
                      0
                    ) * 100
                  );


                card.status =
                  'OCR processing... ' +
                  card.ocrProgress +
                  '%';


                renderCards();

              }

            }

        }
      );


    card.ocrProgress =
      100;


    card.ocrRawText =
      result.data.text || '';


    const number =
      extract16DigitCardNumber(
        card.ocrRawText
      );


    if (number) {

      card.cardNumber =
        number;


      card.status =
        'OCR detected 16-digit card number. Please review it and click VALIDATE CARD NUMBER.';

    }

    else {

      card.cardNumber =
        '';


      card.status =
        'OCR completed, but a valid 16-digit card number was not detected. Enter it manually, then validate.';

    }

  }

  catch (error) {

    card.status =
      'OCR failed: ' +
      (
        error.message ||
        error
      );

  }

  finally {

    card.ocrBusy =
      false;


    renderCards();

  }

}


/* =====================================================
   EXTRACT 16 DIGIT CARD NUMBER
   ===================================================== */

function extract16DigitCardNumber(text) {

  if (!text) return '';


  const continuous =
    text.match(
      /\d{16}/g
    );


  if (
    continuous &&
    continuous.length
  ) {

    return continuous[0];

  }


  const normalized =
    text

      .replace(
        /[Oo]/g,
        '0'
      )

      .replace(
        /[Il|]/g,
        '1'
      )

      .replace(
        /[^\d]/g,
        ' '
      );


  const groups =
    normalized.match(
      /\d+/g
    );


  if (!groups) return '';


  const combined =
    groups.join('');


  if (
    combined.length === 16
  ) {

    return combined;

  }


  const match =
    combined.match(
      /\d{16}/
    );


  return match ?
    match[0] :
    '';

}


/* =====================================================
   SUBMIT REPORT
   ===================================================== */

function submitReport() {

  hideMessages();


  const reportId =
    document.getElementById(
      'reportId'
    ).textContent.trim();


  const storeCode =
    document.getElementById(
      'storeCode'
    ).value.trim();


  const storeName =
    document.getElementById(
      'storeName'
    ).value.trim();


  const area =
    document.getElementById(
      'area'
    ).value.trim();


  const submittedBy =
    document.getElementById(
      'submittedBy'
    ).value.trim();


  const turnover =
    document.querySelector(
      'input[name="turnoverType"]:checked'
    );


  if (
    !reportId ||
    reportId === 'GENERATING...' ||
    reportId === 'ERROR'
  ) {

    return showError(
      'The Unique Report ID is not ready yet.'
    );

  }


  if (!storeCode) {

    return showError(
      'Please select the Store Code.'
    );

  }


  if (!storeName) {

    return showError(
      'Store / Hub Name was not populated. Please reselect the Store Code.'
    );

  }


  if (!submittedBy) {

    return showError(
      'Please enter Reported By / Submitted By.'
    );

  }


  if (!turnover) {

    return showError(
      'Please select Turn-over To: SAME STORE or BSC.'
    );

  }


  if (
    !cardRecords.length ||
    cardRecords.some(
      function(c) {
        return !c.file || !c.dataUrl;
      }
    )
  ) {

    return showError(
      'Every card must have an image.'
    );

  }


  if (
    cardRecords.some(
      function(c) {
        return !/^\d{16}$/.test(
          c.cardNumber
        );
      }
    )
  ) {

    return showError(
      'Every card must have exactly 16 digits. Review the OCR/manual card numbers.'
    );

  }


  if (
    cardRecords.some(
      function(c) {
        return !c.validated;
      }
    )
  ) {

    return showError(
      'Please review and click VALIDATE CARD NUMBER for every card before submitting.'
    );

  }


  let turnoverCode = '';

  let turnoverName = '';


  if (
    turnover.value ===
    'SAME STORE'
  ) {

    turnoverCode =
      document.getElementById(
        'sameStoreCode'
      ).value.trim();


    turnoverName =
      document.getElementById(
        'sameStoreName'
      ).value.trim();


    if (
      !turnoverCode ||
      !turnoverName
    ) {

      return showError(
        'Please select the originating Store Code first. SAME STORE will use it automatically.'
      );

    }

  }

  else {

    turnoverCode =
      document.getElementById(
        'bscCode'
      ).value.trim();


    turnoverName =
      document.getElementById(
        'bscName'
      ).value.trim();


    if (
      !turnoverCode ||
      !turnoverName
    ) {

      return showError(
        'Please select the BSC destination.'
      );

    }

  }


  const payloadCards =
    cardRecords.map(
      function(card) {

        return {

          cardNumber:
            card.cardNumber,

          imageData:
            card.dataUrl,

          ocrRawText:
            card.ocrRawText || ''

        };

      }
    );


  setLoading(
    true,
    'Submitting LBC-RPC Report',
    'Saving ' +
    payloadCards.length +
    ' card(s), OCR, PDF and database records...'
  );


  google.script.run

    .withSuccessHandler(
      function(result) {

        setLoading(false);


        showSuccess(

          '<strong>Report submitted successfully.</strong><br><br>' +

          'Unique Report ID: <strong>' +
          escapeHtml(result.reportId) +
          '</strong><br>' +

          'Cards Submitted: <strong>' +
          escapeHtml(result.count) +
          '</strong><br>' +

          'PDF: <a href="' +
          escapeHtml(result.pdfUrl) +
          '" target="_blank">Open PDF</a><br>' +

          'Email: ' +
          escapeHtml(result.emailStatus)

        );


        resetFormAfterSubmit();

      }
    )

    .withFailureHandler(
      function(error) {

        setLoading(false);


        showError(
          error.message ||
          'Unable to submit the report.'
        );

      }
    )

    .saveCardBatch({

      uniqueId:
        reportId,

      storeCode:
        storeCode,

      storeName:
        storeName,

      area:
        area,

      processor:
        submittedBy,

      turnoverType:
        turnover.value,

      turnoverCode:
        turnoverCode,

      turnoverName:
        turnoverName,

      cards:
        payloadCards

    });

}


/* =====================================================
   RESET AFTER SUBMISSION
   ===================================================== */

function resetFormAfterSubmit() {

  document.getElementById(
    'storeCode'
  ).value = '';


  document.getElementById(
    'storeName'
  ).value = '';


  document.getElementById(
    'area'
  ).value = '';


  document.getElementById(
    'submittedBy'
  ).value = '';


  document.getElementById(
    'sameStoreCode'
  ).value = '';


  document.getElementById(
    'sameStoreName'
  ).value = '';


  document.getElementById(
    'bscCode'
  ).value = '';


  document.getElementById(
    'bscName'
  ).value = '';


  document.querySelectorAll(
    'input[name="turnoverType"]'
  ).forEach(
    function(input) {

      input.checked = false;

    }
  );


  document.getElementById(
    'sameStoreBox'
  ).classList.remove('show');


  document.getElementById(
    'bscBox'
  ).classList.remove('show');


  cardRecords = [];

  ocrQueue = [];


  addEmptyCard();


  generateReportId();

}


/* =====================================================
   RESET REPORT
   ===================================================== */

function resetReport() {

  if (
    !confirm(
      'Clear the current report?'
    )
  ) return;


  resetFormAfterSubmit();

  hideMessages();

}


/* =====================================================
   SHOW SECTION
   ===================================================== */

function showSection(
  sectionId,
  button
) {

  document.querySelectorAll(
    '.section'
  ).forEach(
    function(section) {

      section.classList.remove(
        'active'
      );

    }
  );


  document.querySelectorAll(
    '.nav-button'
  ).forEach(
    function(nav) {

      nav.classList.remove(
        'active'
      );

    }
  );


  document.getElementById(
    sectionId
  ).classList.add(
    'active'
  );


  button.classList.add(
    'active'
  );

}


/* =====================================================
   LOADING
   ===================================================== */

function setLoading(
  show,
  title,
  subtext
) {

  const overlay =
    document.getElementById(
      'loadingOverlay'
    );


  if (!show) {

    overlay.classList.remove(
      'show'
    );

    return;

  }


  document.getElementById(
    'loadingText'
  ).textContent =
    title ||
    'Processing...';


  document.getElementById(
    'loadingSubtext'
  ).textContent =
    subtext ||
    'Please wait.';


  overlay.classList.add(
    'show'
  );

}


/* =====================================================
   SUCCESS
   ===================================================== */

function showSuccess(message) {

  hideMessages();


  const box =
    document.getElementById(
      'successBox'
    );


  box.innerHTML =
    message;


  box.classList.add(
    'show'
  );


  window.scrollTo(
    {
      top: 0,
      behavior: 'smooth'
    }
  );

}


/* =====================================================
   ERROR
   ===================================================== */

function showError(message) {

  hideMessages();


  const box =
    document.getElementById(
      'errorBox'
    );


  box.innerHTML =
    escapeHtml(message);


  box.classList.add(
    'show'
  );


  window.scrollTo(
    {
      top: 0,
      behavior: 'smooth'
    }
  );

}


/* =====================================================
   HIDE MESSAGES
   ===================================================== */

function hideMessages() {

  document.getElementById(
    'successBox'
  ).classList.remove(
    'show'
  );


  document.getElementById(
    'errorBox'
  ).classList.remove(
    'show'
  );

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHtml(value) {

  return String(
    value == null ?
    '' :
    value
  )

    .replace(
      /&/g,
      '&amp;'
    )

    .replace(
      /</g,
      '&lt;'
    )

    .replace(
      />/g,
      '&gt;'
    )

    .replace(
      /"/g,
      '&quot;'
    )

    .replace(
      /'/g,
      '&#039;'
    );

}

