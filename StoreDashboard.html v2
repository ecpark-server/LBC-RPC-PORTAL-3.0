<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  >

  <title>LBC-RPC PORTAL</title>

  <!-- =====================================================
       TESSERACT.JS
       OCR RUNS DIRECTLY IN THE BROWSER
       ===================================================== -->

  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>


  <style>

    * {
      box-sizing: border-box;
    }


    body {

      margin: 0;

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      background: #f4f7fb;

      color: #1f2937;

    }


    /* =====================================================
       HEADER
       ===================================================== */

    .header {

      background: #0878c9;

      color: white;

      padding: 16px 24px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      box-shadow:
        0 2px 8px rgba(0,0,0,0.15);

    }


    .brand {

      display: flex;

      align-items: center;

      gap: 14px;

    }


    .logo {

      width: 55px;

      height: 55px;

      border-radius: 10px;

      object-fit: contain;

      background: white;

      padding: 4px;

    }


    .title {

      font-size: 24px;

      font-weight: 700;

      letter-spacing: .4px;

    }


    .subtitle {

      font-size: 13px;

      margin-top: 3px;

      opacity: .9;

    }


    /* =====================================================
       NAVIGATION
       ===================================================== */

    .navigation {

      background: white;

      border-bottom:
        1px solid #dbe3ec;

      display: flex;

      justify-content: center;

      gap: 5px;

      padding: 10px;

      position: sticky;

      top: 0;

      z-index: 50;

    }


    .nav-button {

      border: none;

      background: transparent;

      padding: 13px 22px;

      border-radius: 8px;

      font-size: 14px;

      font-weight: 600;

      color: #52606d;

      cursor: pointer;

    }


    .nav-button:hover {

      background: #eef6fd;

      color: #0878c9;

    }


    .nav-button.active {

      background: #0878c9;

      color: white;

    }


    /* =====================================================
       CONTAINER
       ===================================================== */

    .container {

      width: 100%;

      max-width: 1200px;

      margin: auto;

      padding: 25px;

    }


    .section {

      display: none;

    }


    .section.active {

      display: block;

    }


    .page-title {

      margin-bottom: 20px;

    }


    .page-title h1 {

      margin: 0;

      font-size: 24px;

    }


    .page-title p {

      margin: 7px 0 0;

      color: #6b7280;

      font-size: 14px;

    }


    /* =====================================================
       REPORT ID
       ===================================================== */

    .report-id-box {

      background:
        linear-gradient(
          135deg,
          #0878c9,
          #0b65a4
        );

      color: white;

      border-radius: 12px;

      padding: 20px;

      margin-bottom: 20px;

      box-shadow:
        0 4px 12px rgba(0,0,0,.10);

    }


    .report-id-label {

      font-size: 12px;

      text-transform: uppercase;

      opacity: .85;

      margin-bottom: 6px;

    }


    .report-id {

      font-size: 22px;

      font-weight: 700;

      letter-spacing: 1px;

    }


    /* =====================================================
       PANEL
       ===================================================== */

    .panel {

      background: white;

      border:
        1px solid #e1e8ef;

      border-radius: 12px;

      padding: 25px;

      margin-bottom: 20px;

      box-shadow:
        0 3px 10px rgba(0,0,0,.05);

    }


    .panel-title {

      font-size: 17px;

      font-weight: 700;

      color: #0878c9;

      margin-bottom: 20px;

      padding-bottom: 10px;

      border-bottom:
        1px solid #edf1f5;

    }


    /* =====================================================
       FORM
       ===================================================== */

    .form-grid {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 18px;

    }


    .form-group {

      display: flex;

      flex-direction: column;

    }


    .form-group.full {

      grid-column:
        1 / -1;

    }


    label {

      font-size: 13px;

      font-weight: 600;

      margin-bottom: 7px;

      color: #374151;

    }


    input,
    select {

      width: 100%;

      height: 44px;

      border:
        1px solid #cfd8e3;

      border-radius: 7px;

      padding:
        0 12px;

      font-size: 14px;

      background: white;

      outline: none;

    }


    input:focus,
    select:focus {

      border-color: #0878c9;

      box-shadow:
        0 0 0 2px
        rgba(8,120,201,.10);

    }


    input[readonly] {

      background: #f5f7fa;

      color: #56616f;

    }


    .required {

      color: #dc2626;

    }


    /* =====================================================
       AREA
       HIDDEN ON ALL DEVICES
       ===================================================== */

    .area-field {

      display: none !important;

    }


    /* =====================================================
       CARD CAPTURE
       ===================================================== */

    .capture-area {

      border:
        2px dashed #b9c9d8;

      border-radius: 12px;

      padding: 30px 20px;

      text-align: center;

      background: #fafcfe;

    }


    .capture-icon {

      font-size: 48px;

      margin-bottom: 10px;

    }


    .capture-title {

      font-size: 17px;

      font-weight: 700;

      margin-bottom: 6px;

    }


    .capture-description {

      color: #6b7280;

      font-size: 13px;

      margin-bottom: 20px;

    }


    .capture-buttons {

      display: flex;

      justify-content: center;

      gap: 10px;

      flex-wrap: wrap;

    }


    .button {

      border: none;

      border-radius: 7px;

      padding: 12px 18px;

      font-size: 14px;

      font-weight: 600;

      cursor: pointer;

    }


    .button-primary {

      background: #0878c9;

      color: white;

    }


    .button-primary:hover {

      background: #066aaa;

    }


    .button-secondary {

      background: #eef3f7;

      color: #334155;

    }


    .button-secondary:hover {

      background: #e1e8ef;

    }


    .button-success {

      background: #168a4a;

      color: white;

    }


    .button-success:hover {

      background: #11733d;

    }


    .button-danger {

      background: #dc3545;

      color: white;

    }


    .button-danger:hover {

      background: #bb2d3b;

    }


    #imageInput {

      display: none;

    }


    .preview-container {

      display: none;

      margin-top: 20px;

    }


    .preview-container.show {

      display: block;

    }


    .preview-image {

      max-width: 100%;

      max-height: 400px;

      border-radius: 8px;

      border:
        1px solid #d7dee7;

    }


    /* =====================================================
       OCR
       ===================================================== */

    .ocr-section {

      margin-top: 20px;

    }


    .ocr-status {

      font-size: 13px;

      color: #64748b;

      margin-bottom: 10px;

    }


    .ocr-progress {

      width: 100%;

      height: 8px;

      background: #e8edf2;

      border-radius: 20px;

      overflow: hidden;

      display: none;

      margin-bottom: 15px;

    }


    .ocr-progress.show {

      display: block;

    }


    .ocr-progress-bar {

      height: 100%;

      width: 0%;

      background: #0878c9;

      transition: width .2s;

    }


    .card-number-input {

      font-size: 20px;

      font-weight: 700;

      letter-spacing: 2px;

      text-align: center;

    }


    .ocr-note {

      margin-top: 8px;

      color: #6b7280;

      font-size: 12px;

    }


    /* =====================================================
       TURN OVER
       ===================================================== */

    .turnover-options {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;

    }


    .turnover-option {

      position: relative;

    }


    .turnover-option input {

      display: none;

    }


    .turnover-label {

      display: block;

      padding: 18px;

      border:
        2px solid #dce4ec;

      border-radius: 10px;

      cursor: pointer;

      text-align: center;

      font-weight: 700;

      color: #52606d;

      transition: .2s;

    }


    .turnover-label:hover {

      border-color: #0878c9;

    }


    .turnover-option input:checked
    + .turnover-label {

      border-color: #0878c9;

      background: #eef7fd;

      color: #0878c9;

    }


    .destination-box {

      display: none;

      margin-top: 20px;

    }


    .destination-box.show {

      display: block;

    }


    /* =====================================================
       SUBMIT
       ===================================================== */

    .submit-area {

      display: flex;

      justify-content: flex-end;

      gap: 10px;

      margin-top: 20px;

    }


    .submit-button {

      min-width: 220px;

      height: 48px;

      font-size: 15px;

    }


    /* =====================================================
       LOADING
       ===================================================== */

    .loading-overlay {

      position: fixed;

      inset: 0;

      background:
        rgba(255,255,255,.90);

      display: none;

      align-items: center;

      justify-content: center;

      z-index: 1000;

    }


    .loading-overlay.show {

      display: flex;

    }


    .loading-box {

      background: white;

      padding: 30px;

      border-radius: 12px;

      box-shadow:
        0 8px 30px rgba(0,0,0,.18);

      text-align: center;

      width: 330px;

    }


    .spinner {

      width: 42px;

      height: 42px;

      border:
        4px solid #e5e7eb;

      border-top-color:
        #0878c9;

      border-radius: 50%;

      animation:
        spin .8s linear infinite;

      margin:
        0 auto 15px;

    }


    @keyframes spin {

      to {
        transform: rotate(360deg);
      }

    }


    /* =====================================================
       SUCCESS / ERROR
       ===================================================== */

    .success-box {

      display: none;

      background: #ecfdf3;

      border:
        1px solid #a7e8c3;

      color: #166534;

      border-radius: 10px;

      padding: 18px;

      margin-bottom: 20px;

    }


    .success-box.show {

      display: block;

    }


    .error-box {

      display: none;

      background: #fff1f2;

      border:
        1px solid #fecdd3;

      color: #9f1239;

      border-radius: 10px;

      padding: 18px;

      margin-bottom: 20px;

    }


    .error-box.show {

      display: block;

    }


    /* =====================================================
       PLACEHOLDER
       ===================================================== */

    .placeholder {

      text-align: center;

      padding: 60px 20px;

      color: #64748b;

    }


    .placeholder-icon {

      font-size: 50px;

      margin-bottom: 15px;

    }


    /* =====================================================
       FOOTER
       ===================================================== */

    footer {

      text-align: center;

      padding: 25px;

      color: #7b8794;

      font-size: 12px;

    }


    /* =====================================================
       MULTI-CARD REPORTING
       ===================================================== */

    .card-list {

      display:flex;

      flex-direction:column;

      gap:18px;

    }


    .card-item {

      border:
        1px solid #dbe3ec;

      border-radius:12px;

      padding:20px;

      background:#fbfdff;

    }


    .card-item-header {

      display:flex;

      align-items:center;

      justify-content:space-between;

      gap:10px;

      margin-bottom:15px;

    }


    .card-item-title {

      font-weight:700;

      color:#0878c9;

    }


    .card-actions {

      display:flex;

      gap:8px;

      flex-wrap:wrap;

    }


    .card-preview-wrap {

      margin-top:15px;

      text-align:center;

    }


    .card-preview {

      max-width:100%;

      max-height:360px;

      border-radius:8px;

      border:
        1px solid #d7dee7;

    }


    .card-empty {

      padding:28px 15px;

      border:
        2px dashed #b9c9d8;

      border-radius:10px;

      color:#64748b;

      text-align:center;

      background:#fff;

    }


    .remove-card {

      padding:8px 12px;

      font-size:12px;

    }


    .add-card-area {

      margin-top:15px;

      display:flex;

      justify-content:center;

    }


    .card-bottom-actions {

      display:flex;

      justify-content:center;

      align-items:center;

      gap:10px;

      flex-wrap:wrap;

      margin-top:15px;

    }


    /* =====================================================
       LIVE CAMERA CAPTURE
       ===================================================== */

    .camera-modal {

      position:fixed;

      inset:0;

      background:rgba(0,0,0,.78);

      display:none;

      align-items:center;

      justify-content:center;

      z-index:10000;

      padding:20px;

    }


    .camera-modal.show {

      display:flex;

    }


    .camera-box {

      width:min(720px, 100%);

      background:#fff;

      border-radius:14px;

      padding:18px;

      box-shadow:
        0 20px 60px rgba(0,0,0,.35);

    }


    .camera-header {

      display:flex;

      justify-content:space-between;

      align-items:center;

      gap:12px;

      margin-bottom:12px;

    }


    .camera-title {

      font-weight:700;

      color:#0878c9;

    }


    .camera-video {

      display:block;

      width:100%;

      max-height:65vh;

      object-fit:contain;

      background:#111;

      border-radius:10px;

    }


    .camera-controls {

      display:flex;

      justify-content:center;

      gap:10px;

      flex-wrap:wrap;

      margin-top:14px;

    }


    .camera-hint {

      margin-top:10px;

      font-size:12px;

      color:#64748b;

      text-align:center;

    }


    .validation-row {

      display:flex;

      align-items:center;

      justify-content:center;

      gap:10px;

      flex-wrap:wrap;

      margin-top:12px;

    }


    .validation-badge {

      font-size:12px;

      font-weight:700;

      padding:7px 10px;

      border-radius:20px;

      background:#eef3f7;

      color:#64748b;

    }


    .validation-badge.valid {

      background:#e8f7ee;

      color:#168a4a;

    }


    .validation-badge.invalid {

      background:#fff0f0;

      color:#dc3545;

    }


    /* =====================================================
       MOBILE PHONE
       GOOGLE-FORM STYLE / LARGE READABLE
       ===================================================== */

    @media screen and (max-width: 800px) {

      body {

        font-size:16px;

        background:#f4f7fb;

      }


      /* HEADER */

      .header {

        padding:14px 16px;

      }


      .brand {

        gap:11px;

      }


      .logo {

        width:48px;

        height:48px;

      }


      .title {

        font-size:20px;

        line-height:1.25;

      }


      .subtitle {

        font-size:13px;

        margin-top:4px;

      }


      /* NAVIGATION */

      .navigation {

        justify-content:flex-start;

        overflow-x:auto;

        gap:6px;

        padding:9px 10px;

        -webkit-overflow-scrolling:touch;

      }


      .nav-button {

        flex:0 0 auto;

        min-height:46px;

        padding:11px 15px;

        font-size:14px;

        white-space:nowrap;

      }


      /* CONTAINER */

      .container {

        width:100%;

        max-width:100%;

        padding:18px 14px;

      }


      /* PAGE TITLE */

      .page-title {

        margin-bottom:18px;

      }


      .page-title h1 {

        font-size:24px;

        line-height:1.25;

      }


      .page-title p {

        font-size:15px;

        line-height:1.5;

      }


      /* PANELS */

      .panel {

        width:100%;

        padding:18px 15px;

        margin-bottom:18px;

        border-radius:12px;

      }


      .panel-title {

        font-size:18px;

        line-height:1.35;

        margin-bottom:18px;

        padding-bottom:11px;

      }


      /* REPORT ID */

      .report-id-box {

        padding:18px;

        margin-bottom:18px;

      }


      .report-id-label {

        font-size:13px;

      }


      .report-id {

        font-size:22px;

        line-height:1.35;

      }


      /* STRICT ONE COLUMN */

      .form-grid {

        display:grid !important;

        grid-template-columns:1fr !important;

        gap:16px !important;

        width:100%;

      }


      .form-group {

        width:100%;

        display:flex;

        flex-direction:column;

      }


      .form-group.full {

        grid-column:auto !important;

      }


      /* LABELS */

      label {

        font-size:16px;

        line-height:1.4;

        font-weight:700;

        margin-bottom:8px;

        color:#263342;

      }


      .required {

        font-size:16px;

      }


      /* INPUTS / SELECTS */

      input,
      select {

        width:94%;

        max-width:94%;

        height:50px;

        padding:0 13px;

        font-size:16px;

        line-height:1.4;

        border-radius:8px;

        border:1px solid #c7d2de;

      }


      input::placeholder {

        font-size:15px;

        color:#7a8794;

      }


      select {

        font-size:16px;

      }


      input[readonly] {

        background:#f3f5f7;

      }


      /* STORE / REPORT INFORMATION */

      #storeCode,
      #storeName,
      #submittedBy {

        width:94%;

        max-width:94%;

      }


      /* AREA MUST ALWAYS BE HIDDEN */

      .area-field {

        display:none !important;

      }


      /* TURNOVER ONE COLUMN */

      .turnover-options {

        display:grid !important;

        grid-template-columns:1fr !important;

        gap:12px;

        width:100%;

      }


      .turnover-option {

        width:100%;

      }


      .turnover-label {

        width:94%;

        padding:17px 14px;

        min-height:56px;

        display:flex;

        align-items:center;

        justify-content:center;

        font-size:16px;

        line-height:1.3;

        border-radius:9px;

      }


      /* DESTINATION */

      .destination-box {

        margin-top:18px;

      }


      .destination-box .form-grid {

        grid-template-columns:1fr !important;

      }


      /* CARD LIST */

      .card-list {

        gap:16px;

      }


      .card-item {

        padding:15px;

        border-radius:11px;

      }


      .card-item-header {

        flex-direction:column;

        align-items:flex-start;

        gap:12px;

      }


      .card-item-title {

        font-size:18px;

      }


      .card-actions {

        width:94%;

        display:grid;

        grid-template-columns:1fr;

        gap:9px;

      }


      .card-actions .button {

        width:100%;

      }


      /* CARD PREVIEW */

      .card-preview-wrap {

        margin-top:15px;

      }


      .card-preview {

        width:94%;

        max-width:94%;

        max-height:300px;

        object-fit:contain;

      }


      /* OCR */

      .ocr-section {

        margin-top:20px;

      }


      .ocr-section label {

        font-size:16px;

      }


      .card-number-input {

        width:94%;

        max-width:94%;

        height:54px;

        font-size:19px;

        font-weight:700;

        letter-spacing:2px;

        text-align:center;

      }


      .ocr-status {

        width:94%;

        font-size:14px;

        line-height:1.5;

        margin-top:9px;

      }


      .ocr-note {

        width:94%;

        font-size:14px;

        line-height:1.5;

      }


      .ocr-progress {

        width:94%;

        height:9px;

      }


      /* VALIDATION */

      .validation-row {

        width:94%;

        flex-direction:column;

        align-items:stretch;

        gap:9px;

      }


      .validation-row .button {

        width:100%;

        min-height:50px;

        font-size:15px;

      }


      .validation-badge {

        width:100%;

        text-align:center;

        font-size:14px;

        padding:9px;

      }


      /* CARD BOTTOM ACTIONS */

      .card-bottom-actions {

        width:94%;

        display:grid;

        grid-template-columns:1fr;

        gap:10px;

        margin:16px auto 0;

      }


      .card-bottom-actions .button {

        width:100%;

        min-height:50px;

        font-size:15px;

      }


      /* GENERAL BUTTONS */

      .button {

        min-height:50px;

        padding:12px 16px;

        font-size:15px;

        line-height:1.3;

        border-radius:8px;

      }


      /* SUBMIT */

      .submit-area {

        width:94%;

        margin:20px auto 0;

        display:grid;

        grid-template-columns:1fr;

        gap:10px;

      }


      .submit-area .button {

        width:100%;

        min-height:52px;

      }


      .submit-button {

        width:100%;

        min-width:0;

        height:52px;

        font-size:16px;

      }


      /* SUCCESS / ERROR */

      .success-box,
      .error-box {

        width:100%;

        padding:16px;

        font-size:15px;

        line-height:1.55;

      }


      /* PLACEHOLDER */

      .placeholder {

        padding:45px 15px;

      }


      .placeholder-icon {

        font-size:46px;

      }


      .placeholder h2 {

        font-size:21px;

        line-height:1.35;

      }


      .placeholder p {

        font-size:15px;

        line-height:1.55;

      }


      /* CAMERA */

      .camera-modal {

        padding:10px;

      }


      .camera-box {

        width:100%;

        padding:14px;

        border-radius:12px;

      }


      .camera-title {

        font-size:16px;

      }


      .camera-video {

        max-height:60vh;

      }


      .camera-controls {

        display:grid;

        grid-template-columns:1fr;

        gap:9px;

      }


      .camera-controls .button {

        width:100%;

        min-height:50px;

      }


      .camera-hint {

        font-size:14px;

        line-height:1.5;

      }


      /* LOADING */

      .loading-box {

        width:88%;

        max-width:350px;

        padding:25px 20px;

      }


      #loadingText {

        font-size:17px;

      }


      #loadingSubtext {

        font-size:14px !important;

        line-height:1.5;

      }


      /* FOOTER */

      footer {

        padding:22px 15px;

        font-size:13px;

      }

    }


    /* =====================================================
       VERY SMALL PHONES
       ===================================================== */

